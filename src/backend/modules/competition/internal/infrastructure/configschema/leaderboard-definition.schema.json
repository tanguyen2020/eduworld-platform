{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eduworld:schema:leaderboard-definition:1",
  "title": "LeaderboardDefinitionCatalog",
  "description": "Danh mục định nghĩa bảng xếp hạng (config_type leaderboard-definitions, code default — F106, F108; COMPETITION_SYSTEM §9.1–§9.2): metric × scope × period (+ filter). Không có scope class hay metric class_goal (ADR-0095 — mục tiêu tập thể dùng grade_goal với display.grade_goal_target); xp chỉ ở scope friends (không xếp XP trong trường/khối); rating chỉ khối 6–9. Worker chép các định nghĩa vào competition.leaderboard_definitions khi version có hiệu lực (F108-AC-08). Mức hiển thị theo khối: CONFIG_DEFAULTS leaderboard_visibility (Ranking Rules).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definitions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "leaderboard_id",
          "code",
          "title",
          "metric",
          "scope_type",
          "period",
          "filters",
          "grade_levels",
          "display",
          "sort_order",
          "status"
        ],
        "properties": {
          "leaderboard_id": {
            "type": "string",
            "format": "uuid"
          },
          "code": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_]{1,63}$",
            "maxLength": 64
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "metric": {
            "type": "string",
            "enum": [
              "competition_points",
              "effort_points",
              "grade_goal",
              "xp",
              "quest_completed",
              "rating",
              "team_points"
            ]
          },
          "scope_type": {
            "type": "string",
            "enum": [
              "global",
              "tenant",
              "school",
              "grade",
              "friends",
              "team",
              "tournament"
            ]
          },
          "period": {
            "type": "string",
            "enum": [
              "daily",
              "weekly",
              "monthly",
              "season",
              "all_time"
            ]
          },
          "filters": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "subject_id": {
                "type": "string",
                "format": "uuid"
              },
              "topic_id": {
                "type": "string",
                "format": "uuid"
              },
              "mode": {
                "type": "string",
                "enum": [
                  "battle_1v1",
                  "team_battle",
                  "coop_challenge",
                  "timed_quiz",
                  "tournament"
                ]
              }
            }
          },
          "grade_levels": {
            "type": "array",
            "minItems": 1,
            "maxItems": 9,
            "uniqueItems": true,
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9
            }
          },
          "display": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "grade_goal_target": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1000000,
                "description": "Mục tiêu tuần của bảng grade_goal (bắt buộc khi metric = grade_goal)"
              }
            }
          },
          "sort_order": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "retired"
            ]
          }
        }
      }
    }
  }
}
