{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eduworld:schema:progression-curve:1",
  "title": "ProgressionCurveVersion",
  "description": "Đường cong XP → level, danh hiệu và phần thưởng lên cấp (nội dung platform, version hóa theo ADR-0043). Xem docs/01-game-design/PROGRESSION_SYSTEM.md §4.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "curve_id",
    "curve_version_id",
    "code",
    "version",
    "status",
    "owner_scope",
    "max_level",
    "formula",
    "titles"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "curve_id": {
      "$ref": "#/$defs/uuid"
    },
    "curve_version_id": {
      "$ref": "#/$defs/uuid"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)*$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived",
        "rejected"
      ]
    },
    "owner_scope": {
      "const": "platform"
    },
    "tenant_id": {
      "type": "null"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    },
    "max_level": {
      "type": "integer",
      "minimum": 2,
      "maximum": 200
    },
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "base",
        "exponent",
        "linear"
      ],
      "description": "xp_to_next(L) = round(base × L^exponent + linear × L)",
      "properties": {
        "kind": {
          "const": "power_linear"
        },
        "base": {
          "type": "number",
          "minimum": 1,
          "maximum": 100000
        },
        "exponent": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 3
        },
        "linear": {
          "type": "number",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "level_overrides": {
      "type": "array",
      "description": "Ghi đè xp_required (XP cần để từ level này lên level tiếp) cho một số level",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "xp_to_next"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "xp_to_next": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000
          }
        }
      }
    },
    "titles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "from_level",
          "name"
        ],
        "properties": {
          "code": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "from_level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "name": {
            "$ref": "#/$defs/localized_text"
          }
        }
      }
    },
    "level_rewards": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "level",
          "rewards"
        ],
        "properties": {
          "level": {
            "type": "integer",
            "minimum": 2,
            "maximum": 200
          },
          "rewards": {
            "type": "array",
            "minItems": 1,
            "maxItems": 10,
            "items": {
              "$ref": "#/$defs/reward"
            }
          }
        }
      }
    },
    "level_floor_protection": {
      "type": "boolean",
      "default": true,
      "description": "Publish version mới không làm giảm level hiện tại"
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "localized_text": {
      "type": "object",
      "description": "Văn bản hiển thị song ngữ bắt buộc đủ vi và en (ADR-0056 mục 2).",
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      },
      "additionalProperties": false
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "currency",
            "item",
            "badge",
            "title",
            "collection_item"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "currency_code": {
          "type": "string",
          "maxLength": 64
        },
        "item_id": {
          "type": "string",
          "maxLength": 64
        },
        "badge_id": {
          "type": "string",
          "maxLength": 64
        },
        "title_code": {
          "type": "string",
          "maxLength": 64
        },
        "collection_item_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "currency"
              }
            }
          },
          "then": {
            "required": [
              "currency_code",
              "amount"
            ],
            "properties": {
              "currency_code": true,
              "amount": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "item"
              }
            }
          },
          "then": {
            "required": [
              "item_id"
            ],
            "properties": {
              "item_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "badge"
              }
            }
          },
          "then": {
            "required": [
              "badge_id"
            ],
            "properties": {
              "badge_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "title"
              }
            }
          },
          "then": {
            "required": [
              "title_code"
            ],
            "properties": {
              "title_code": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "collection_item"
              }
            }
          },
          "then": {
            "required": [
              "collection_item_id"
            ],
            "properties": {
              "collection_item_id": true
            }
          }
        }
      ]
    }
  }
}
