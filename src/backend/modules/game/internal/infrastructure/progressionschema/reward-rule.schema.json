{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eduworld:schema:reward-rule:1",
  "title": "RewardRule",
  "description": "Quy tắc thưởng của Reward Engine (gamification). Áp dụng phía server khi nhận domain event; có cap và diminishing returns để chống farm. Reward không ảnh hưởng điểm/mastery/kết quả đánh giá chính thức. source_code theo catalog PROGRESSION_SYSTEM §3.1 (F074). Xem docs/06-architecture/DOMAIN_MODEL.md §8.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "reward_rule_id",
    "code",
    "version",
    "status",
    "owner_scope",
    "source_code",
    "trigger",
    "grants",
    "caps"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "reward_rule_id": {
      "$ref": "#/$defs/uuid"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "source_code": {
      "type": "string",
      "maxLength": 64,
      "enum": [
        "quest.main_completed",
        "quest.side_completed",
        "quest.daily_completed",
        "quest.weekly_completed",
        "activity.completed",
        "mastery.objective_mastered",
        "lesson.completed",
        "exploration.discovery",
        "exploration.area_completed",
        "challenge.completed",
        "boss.defeated",
        "coop.contribution",
        "achievement.unlocked",
        "event.participation",
        "competition.participation"
      ],
      "description": "Mã nguồn XP trong catalog PROGRESSION_SYSTEM §3.1; ghi vào xp_ledger.source_code (F074). Reward Engine chỉ áp rule có source_code khớp nguồn suy ra từ event."
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived",
        "rejected"
      ]
    },
    "owner_scope": {
      "const": "platform",
      "description": "Cấu hình game chỉ thuộc platform, sửa qua /api/v1/game-admin (ADR-0027); tenant dùng khi được gán (ADR-0029)"
    },
    "tenant_id": {
      "type": "null",
      "description": "Luôn null: dữ liệu platform"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "priority": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000,
      "default": 100
    },
    "active_from": {
      "type": "string",
      "format": "date-time",
      "description": "Event có occurred_at từ thời điểm này mới áp version này (F074-AC-24); vắng = từ lúc publish"
    },
    "active_to": {
      "type": "string",
      "format": "date-time"
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type"
      ],
      "properties": {
        "event_type": {
          "enum": [
            "activity.graded",
            "lesson.completed",
            "exercise.submitted",
            "quest.completed",
            "minigame.completed",
            "challenge.completed",
            "match.completed",
            "achievement.unlocked",
            "learning_objective.mastered",
            "party.activity_completed",
            "world.discovery_found",
            "world.area_completed"
          ]
        },
        "attempt_modes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "https://schemas.eduworld.vn/common/enums.schema.json#/$defs/AttemptMode"
          },
          "description": "Giới hạn theo Attempt.mode. Mặc định đề xuất không gồm exam chính thức."
        }
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "min_correct_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_questions_answered": {
          "type": "integer",
          "minimum": 1
        },
        "first_completion_only": {
          "type": "boolean",
          "default": false
        },
        "grade_levels": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "subject_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          }
        },
        "source_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/uuid"
          },
          "description": "Quest/minigame/question set cụ thể"
        },
        "min_party_size": {
          "type": "integer",
          "minimum": 2
        },
        "min_individual_contribution": {
          "type": "integer",
          "minimum": 1
        },
        "challenge_statuses": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "succeeded",
              "failed"
            ]
          },
          "description": "Chỉ với trigger challenge.completed (F076): trạng thái kết thúc được thưởng; vắng = chỉ succeeded. abandoned không bao giờ được thưởng, không trừ XP khi failed"
        }
      }
    },
    "grants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "xp",
              "title",
              "currency",
              "item",
              "badge",
              "collection_item",
              "achievement_progress"
            ]
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          },
          "per_correct_answer": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "currency_code": {
            "const": "xu",
            "description": "Chỉ tiền trong game Xu (ADR-0049, OQ-14); số Xu nhân hệ số giảm dần khi lặp như XP rồi bị cap `xu_daily_cap` (F075)"
          },
          "item_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$",
            "description": "Mã vật phẩm (game.item_definitions.item_id, RB-308)"
          },
          "badge_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$",
            "description": "Mã vật phẩm loại badge (F075: badge là vật phẩm kind = badge)"
          },
          "title_code": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "achievement_id": {
            "type": "string",
            "maxLength": 64
          },
          "progress": {
            "type": "integer",
            "minimum": 1
          },
          "collection_item_id": {
            "type": "string",
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$",
            "description": "Mã vật phẩm thuộc một collection (F075)"
          },
          "scale_by": {
            "enum": [
              "reward_multiplier"
            ],
            "description": "Nhân amount/per_correct_answer (XP) và amount (Xu) với reward_multiplier của mức khó trong payload challenge.completed (F076), làm tròn xuống, trước giảm dần và cap; trigger khác bỏ qua"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "xp"
                }
              }
            },
            "then": {
              "anyOf": [
                {
                  "required": [
                    "amount"
                  ],
                  "properties": {
                    "amount": true
                  }
                },
                {
                  "required": [
                    "per_correct_answer"
                  ],
                  "properties": {
                    "per_correct_answer": true
                  }
                }
              ]
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "title"
                }
              }
            },
            "then": {
              "required": [
                "title_code"
              ],
              "properties": {
                "title_code": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "item"
                }
              }
            },
            "then": {
              "required": [
                "item_id"
              ],
              "properties": {
                "item_id": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "badge"
                }
              }
            },
            "then": {
              "required": [
                "badge_id"
              ],
              "properties": {
                "badge_id": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "achievement_progress"
                }
              }
            },
            "then": {
              "required": [
                "achievement_id",
                "progress"
              ],
              "properties": {
                "achievement_id": true,
                "progress": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "currency"
                }
              }
            },
            "then": {
              "required": [
                "amount",
                "currency_code"
              ],
              "properties": {
                "amount": true,
                "currency_code": true
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "const": "collection_item"
                }
              }
            },
            "then": {
              "required": [
                "collection_item_id"
              ],
              "properties": {
                "collection_item_id": true
              }
            }
          }
        ]
      }
    },
    "caps": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "xp_per_day"
      ],
      "properties": {
        "xp_per_day": {
          "type": "integer",
          "minimum": 0,
          "description": "Cap XP/ngày (ngày lịch Asia/Ho_Chi_Minh) của bucket; phải ≥ 1 khi publish (F074-AC-23)"
        },
        "xp_per_week": {
          "type": "integer",
          "minimum": 0
        },
        "grants_per_source_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "bucket": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^xp:[a-z0-9_.:]+$",
          "description": "Bucket đếm cap trong xp_daily_caps; vắng = xp:src:<source_type> của nguồn (F074)"
        }
      }
    },
    "diminishing_returns": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "multipliers",
        "window_days"
      ],
      "description": "Hệ số áp dụng cho lần hoàn thành lặp lại cùng nguồn nội dung trong cửa sổ thời gian. Phần tử cuối áp dụng cho mọi lần tiếp theo.",
      "properties": {
        "multipliers": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  }
}
