{
  "name": "@eduworld/portal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build && node scripts/check-chunks.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json",
    "gen:api": "node scripts/gen-op-meta.mjs && node scripts/gen-menu-catalog.mjs && node scripts/gen-schemas.mjs",
    "gen:catalog": "node scripts/gen-menu-catalog.mjs",
    "gen:check": "node scripts/gen-op-meta.mjs --check && node scripts/gen-menu-catalog.mjs --check && node scripts/gen-schemas.mjs --check",
    "gen:schemas": "node scripts/gen-schemas.mjs"
  },
  "dependencies": {
    "@ant-design/icons": "5.6.1",
    "@eduworld/ops-ui": "workspace:*",
    "@tanstack/react-query": "5.104.5",
    "ajv": "8.20.0",
    "antd": "5.29.3",
    "dayjs": "1.11.23",
    "i18next": "25.10.10",
    "openapi-fetch": "0.17.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "15.7.4",
    "react-router-dom": "6.30.6"
  },
  "devDependencies": {
    "@storybook/react": "8.6.19",
    "@testing-library/jest-dom": "6.10.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "js-yaml": "4.3.2",
    "jsdom": "26.1.0",
    "msw": "2.15.0",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "6.4.5",
    "vitest": "3.2.7"
  }
}
