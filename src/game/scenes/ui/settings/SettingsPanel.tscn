[node name="Box" type="VBoxContainer" parent="Window/Main"]
layout_mode = 2
size_flags_horizontal = 3

[node name="Header" type="HBoxContainer" parent="Window/Main/Box"]
layout_mode = 2

[node name="Title" type="Label" parent="Window/Main/Box/Header"]
