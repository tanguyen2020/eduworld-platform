[ext_resource type="Texture2D" path="res://resources/ui/icons/info.svg" id="4_info"]

[node name="SettingsPanel" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Window" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = -1
anchor_left = 0.15
anchor_top = 0.08
anchor_right = 0.85
anchor_bottom = 0.92
grow_horizontal = 2
grow_vertical = 2

[node name="Main" type="ScrollContainer" parent="Window"]
unique_name_in_owner = true
layout_mode = 2
