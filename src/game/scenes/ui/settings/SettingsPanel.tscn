[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/ui/settings/settings_panel.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://scenes/ui/settings/QualitySettings.tscn" id="2_quality"]
