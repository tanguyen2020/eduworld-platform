extends SceneTree
## CLI (GODOT_ARCHITECTURE §10.1, F060-AC-17): generates res://locale/xx_PS.po from en.po (+40 %, accents).
##   godot --headless --path src/game -s res://tools/pseudo_locale.gd [-- --check]

const ToolFiles := preload("res://tools/lib/tool_files.gd")
const PoFile := preload("res://tools/lib/po_file.gd")
const Pseudo := preload("res://tools/lib/pseudo.gd")

const SOURCE_PATH: String = "res://locale/en.po"
const OUTPUT_PATH: String = "res://locale/xx_PS.po"
const COMMENT: String = "# GENERATED by src/game/tools/pseudo_locale.gd from en.po — DO NOT EDIT. Debug builds only.\n"
const HEADER: PackedStringArray = [
	"Project-Id-Version: EduWorld game", "Language: xx_PS", "MIME-Version: 1.0",
	"Content-Type: text/plain; charset=UTF-8", "Content-Transfer-Encoding: 8bit", "Plural-Forms: nplurals=2; plural=(n != 1);",
]


func _initialize() -> void:
	var violations: PackedStringArray = []
	var source: Dictionary = PoFile.parse(FileAccess.get_file_as_string(SOURCE_PATH))
	var text: String = PoFile.write(HEADER, Pseudo.build(source), COMMENT)
	if "--check" in OS.get_cmdline_user_args():
		if not FileAccess.file_exists(OUTPUT_PATH) or FileAccess.get_file_as_string(OUTPUT_PATH) != text:
			violations.append("%s is stale: run tools/pseudo_locale.gd and commit it" % OUTPUT_PATH)
	else:
		var file: FileAccess = FileAccess.open(OUTPUT_PATH, FileAccess.WRITE)
		if file == null:
			violations.append("cannot write %s" % OUTPUT_PATH)
		else:
			file.store_string(text)
			file.close()
	quit(ToolFiles.report("pseudo_locale", violations, 1))
