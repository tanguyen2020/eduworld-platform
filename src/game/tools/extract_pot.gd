extends SceneTree
## CLI (GODOT_ARCHITECTURE §10.1, F060-AC-13, TC-I18N-005):
##   godot --headless --path src/game -s res://tools/extract_pot.gd            → writes res://locale/messages.pot
##   godot --headless --path src/game -s res://tools/extract_pot.gd -- --check → exit 1 when messages.pot is stale,
##     a key is missing from vi.po / en.po, or a scene has hard-coded visible text.

const ToolFiles := preload("res://tools/lib/tool_files.gd")
const PoFile := preload("res://tools/lib/po_file.gd")
const I18nRules := preload("res://tools/lib/i18n_rules.gd")

const POT_PATH: String = "res://locale/messages.pot"
const CATALOGS: PackedStringArray = ["res://locale/vi.po", "res://locale/en.po"]
const POT_COMMENT: String = "# GENERATED by src/game/tools/extract_pot.gd — DO NOT EDIT. Translation keys of the game UI.\n"
const POT_HEADER: PackedStringArray = [
	"Project-Id-Version: EduWorld game", "MIME-Version: 1.0", "Content-Type: text/plain; charset=UTF-8",
	"Content-Transfer-Encoding: 8bit",
]


func _initialize() -> void:
	var check: bool = "--check" in OS.get_cmdline_user_args()
	var violations: PackedStringArray = []
	var keys: PackedStringArray = []
	var files: PackedStringArray = []
	for root_dir: String in I18nRules.SOURCE_ROOTS:
		files.append_array(ToolFiles.list_files(root_dir, I18nRules.SOURCE_EXTENSIONS))
	for path: String in files:
		var text: String = ToolFiles.read_text(path)
		for key: String in I18nRules.keys_in(text):
			if not key in keys:
				keys.append(key)
		if path.ends_with(".tscn"):
			violations.append_array(I18nRules.hardcoded_text(path, text))
	keys.sort()
	var entries: Dictionary = {}
	for key: String in keys:
		entries[key] = ""
	var pot: String = PoFile.write(POT_HEADER, entries, POT_COMMENT)
	if check:
		if not FileAccess.file_exists(POT_PATH) or FileAccess.get_file_as_string(POT_PATH) != pot:
			violations.append("%s is stale: run tools/extract_pot.gd and commit it" % POT_PATH)
		for catalog_path: String in CATALOGS:
			var catalog: Dictionary = PoFile.parse(FileAccess.get_file_as_string(catalog_path))
			for key: String in I18nRules.missing(keys, catalog):
				violations.append("%s: missing translation for '%s'" % [catalog_path, key])
	else:
		var file: FileAccess = FileAccess.open(POT_PATH, FileAccess.WRITE)
		if file == null:
			violations.append("cannot write %s" % POT_PATH)
		else:
			file.store_string(pot)
			file.close()
			print("extract_pot: wrote %d keys to %s" % [keys.size(), POT_PATH])
	quit(ToolFiles.report("extract_pot", violations, files.size()))
