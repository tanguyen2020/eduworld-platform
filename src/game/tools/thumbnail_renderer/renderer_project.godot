; Minimal Godot project of the game-renderer container (F078 US5, research R2). deploy/docker/game-renderer.Dockerfile
; copies it as /opt/eduworld/game/project.godot next to the only files the renderer needs, at their game paths:
;   tools/thumbnail_renderer/*.gd            (render_thumbnails.gd, render_plan.gd)
;   resources/art/generated/art3d_tokens.gd  (sun colour, Environment paths — generated from design/game-tokens)
;   resources/art/generated/env_*.tres       (game zone Environments)
; so `--script res://tools/thumbnail_renderer/render_thumbnails.gd` is the same path as in the full project
; (`make render-thumbnails`). The full src/game/project.godot is not used in the container: its autoloads (Config,
; ApiClient, RealtimeClient, …) start with every SceneTree script, need the whole client and would open network
; services in a render job; its editor plugin and translations are not shipped either.
; Keep the Godot version and the GDScript warning levels aligned with src/game/project.godot.

config_version=5

[application]

config/name="EduWorld thumbnail renderer"
config/description="Renders thumbnails and turntables of 3D game assets (game-renderer container)"
config/features=PackedStringArray("4.7", "GL Compatibility")

[audio]

driver/driver="Dummy"

[debug]

gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=640
window/size/viewport_height=480

[rendering]

; Xvfb has no GPU: the Compatibility renderer over OpenGL 3.3 (Mesa llvmpipe) — the container also passes
; --rendering-driver opengl3.
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
