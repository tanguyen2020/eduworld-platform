#!/usr/bin/env python
# EduWorld platform GDExtension — Windows DPAPI cipher for SecureStorage (ADR-0086, F060 T051).
# Built in CI (godot.yml, job "platform-windows") with MSVC against godot-cpp pinned to tag godot-4.5-stable
# (compatibility_minimum 4.5, loads in the pinned 4.7 editor/runtime):
#   scons platform=windows target=template_debug   godot_cpp=<godot-cpp checkout>
#   scons platform=windows target=template_release godot_cpp=<godot-cpp checkout>
# Output: addons/eduworld_platform/bin/eduworld_platform.windows.<target>.x86_64.dll; the build also installs
# addons/eduworld_platform/eduworld_platform.gdextension from the .template next to this file (both git-ignored),
# so a checkout without the built DLL never tries to load a missing library (SecureStorage then uses MemoryOnly).
import os
import shutil

godot_cpp = ARGUMENTS.pop("godot_cpp", "godot-cpp")
env = SConscript(os.path.join(godot_cpp, "SConstruct"))
env.Append(CPPPATH=["src/"])
if env["platform"] == "windows":
    env.Append(LIBS=["Crypt32"])

sources = Glob("src/*.cpp")
library = env.SharedLibrary(
    "../bin/eduworld_platform{}{}".format(env["suffix"], env["SHLIBSUFFIX"]),
    source=sources,
)


def install_gdextension(target, source, env):
    shutil.copyfile("eduworld_platform.gdextension.template", "../eduworld_platform.gdextension")


env.AddPostAction(library, install_gdextension)
Default(library)
