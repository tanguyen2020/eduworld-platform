<?xml version="1.0" encoding="utf-8"?>
<!-- EduWorld platform Android plugin (Godot v2 plugin, ADR-0086, F060 T052). No runtime permission needed.
     F133 T047 (F133-AC-24): the merged app manifest gets the backup exclusion rules of res/xml (session folder kept out
     of Auto Backup and device transfer); checked on every artifact by scripts/godot/check-secure-storage.mjs. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules">
        <meta-data
            android:name="org.godotengine.plugin.v2.EduWorldPlatform"
            android:value="vn.eduworld.platform.KeystoreSecureStorage" />
    </application>
</manifest>
