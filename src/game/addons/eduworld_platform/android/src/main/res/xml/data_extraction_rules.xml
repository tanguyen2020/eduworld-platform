<?xml version="1.0" encoding="utf-8"?>
<!-- F133 T047, F133-AC-24, ADR-0086 (Android 12+, android:dataExtractionRules): the session never leaves the device.
     The Keystore plugin writes only ciphertext to noBackupFilesDir/secure (never backed up); user://secure (earlier
     file-backed records) and the content cache user://cache (public packs, downloaded again) are excluded from cloud
     backup and device-to-device transfer as a second layer. allowBackup is false in the release preset as well. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="secure/" />
        <exclude domain="file" path="cache/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="secure/" />
        <exclude domain="file" path="cache/" />
    </device-transfer>
</data-extraction-rules>
