class_name RealtimeHarness
extends RefCounted
## TEST-ONLY (AGENTS R17): a GameRealtimeClient on FakeHttp + FakeClock + FakeWebSocketPeer (F092 tests). Ticket
## replies, the welcome and server frames come from the AsyncAPI example fixtures
## (res://tests/fixtures/contract/asyncapi, generated by tools/gen_fixtures.mjs). The client is not polled by
## `_process`: tests call `tick()` after moving the fake clock.

const FIXTURES: String = "res://tests/fixtures/contract/asyncapi"
const ROUTE_TICKET: String = "POST /game/sessions/*/realtime-tickets"
const SESSION_ID: String = "33333333-3333-4333-8333-333333333333"
const TENANT_ID: String = "00000000-0000-4000-8000-000000000001"
const TICKET: String = "rt-ticket-F092-secret-000000000000000001"
const ACCESS: String = "access-F092-aaaa-0001"
const WS_URL: String = "wss://rt.test.invalid/realtime/v1"

var http: FakeHttp = FakeHttp.new()
var clock: FakeClock = FakeClock.new()
var api: RestApiClient = null
var client: GameRealtimeClient = null
var peers: Array[FakeWebSocketPeer] = []
var states: Array[int] = []
var next_seq: int = 100


static func create() -> RealtimeHarness:
	var h: RealtimeHarness = RealtimeHarness.new()
	h._build()
	return h


func _build() -> void:
	api = RestApiClient.new()
	var tokens: TokenStore = TokenStore.new()
	tokens.apply({"access_token": ACCESS, "refresh_token": "refresh-F092", "expires_in": 3600}, clock.now_msec())
	tokens.tenant_id = TENANT_ID
	api.configure(http, clock, tokens, "11111111-1111-4111-8111-111111111111", http.base_url, "1.2.3", "windows")
	var rng: RandomNumberGenerator = RandomNumberGenerator.new()
	rng.seed = 92
	api.rng = rng
	client = GameRealtimeClient.new()
	client.auto_poll = false
	client.rng = rng
	client.allow_insecure = false
	client.configure(api, clock, _new_peer)
	client.connection_state_changed.connect(func(s: int) -> void: states.append(s))
	Log.clear()


func dispose() -> void:
	if client != null:
		client.stop()
		client.free()
	if api != null:
		api.free()


func _new_peer() -> WsPeer:
	var p: FakeWebSocketPeer = FakeWebSocketPeer.new()
	peers.append(p)
	return p


func peer() -> FakeWebSocketPeer:
	return peers[peers.size() - 1] if not peers.is_empty() else null


func reply_ticket(url: String = WS_URL) -> void:
	http.reply(ROUTE_TICKET, 201, {"ticket": TICKET, "expires_at": "2026-11-21T08:00:01Z", "url": url,
			"protocol_version": 1})


static func fixture(name: String) -> Dictionary:
	return (JSON.parse_string(FileAccess.get_file_as_string("%s/%s.json" % [FIXTURES, name])) as Dictionary).duplicate(true)


## A server envelope of `type` with the next seq (payload from the caller).
func envelope(type: String, payload: Dictionary, ref: String = "") -> Dictionary:
	next_seq += 1
	var env: Dictionary = {"v": 1, "type": type, "seq": next_seq, "ts": client.server_now_ms(), "payload": payload}
	if not ref.is_empty():
		env["ref"] = ref
	return env


## Coroutine: waits until the ticket request was answered and the peer exists (or the client gave up).
func await_ticket() -> void:
	var tree: SceneTree = Engine.get_main_loop() as SceneTree
	for i: int in 20:
		if client.state != GameRealtimeClient.State.FETCHING_TICKET:
			return
		await tree.process_frame


## Coroutine: start → ticket → handshake → welcome (fixture) → Online.
func connect_online(welcome_seq: int = 1) -> void:
	reply_ticket()
	client.start(SESSION_ID)
	await await_ticket()
	open_with_welcome(welcome_seq)


## Completes the handshake of the current peer and delivers a welcome.
func open_with_welcome(welcome_seq: int = 1, token: String = "rt-example-opaque-0001") -> void:
	peer().open()
	var welcome: Dictionary = fixture("system.session.welcome.new_connection")
	welcome["seq"] = welcome_seq
	(welcome["payload"] as Dictionary)["resume_token"] = token
	(welcome["payload"] as Dictionary)["server_time"] = 1_763_600_000_000
	peer().push(welcome)
	client.tick()


## Server → client frame then one poll.
func push(env: Dictionary) -> void:
	peer().push(env)
	client.tick()


## Pushes an AsyncAPI example fixture with the next seq (and the current server time).
func push_fixture(name: String) -> Dictionary:
	var env: Dictionary = fixture(name)
	next_seq += 1
	env["seq"] = next_seq
	env["ts"] = client.server_now_ms()
	push(env)
	return env


func advance_ms(ms: int) -> void:
	clock.advance(float(ms) / 1000.0)
	client.tick()


## Answers the last command of `type` with `system.command.acked` / `failed`.
func ack_last(type: String, ok: bool = true, code: String = "") -> void:
	var sent: Array[Dictionary] = peer().sent_of(type)
	var id: String = String(sent[sent.size() - 1]["id"])
	if ok:
		push(envelope("system.command.acked", {"result": {}}, id))
	else:
		push(envelope("system.command.failed", {"code": code, "message": "x"}, id))
