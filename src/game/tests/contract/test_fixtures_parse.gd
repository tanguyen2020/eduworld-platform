extends GdUnitTestSuite
## F060-AC-22 (GODOT_ARCHITECTURE §12, NFR-MAINT-002): every response sample from specs/openapi and specs/examples
## that the client uses (generated by src/game/tools/gen_fixtures.mjs) parses into GDScript models without error;
## every problem code with its own message exists in the spec's ProblemCode enum.

const FIXTURES: String = "res://tests/fixtures/contract"
const SPEC_RELATIVE: String = "../../specs/openapi/eduworld-api.v1.yaml"


func _json(path: String) -> Variant:
	var parser: JSON = JSON.new()
	var err: Error = parser.parse(FileAccess.get_file_as_string(path))
	assert_int(err).override_failure_message("%s: %s" % [path, parser.get_error_message()]).is_equal(OK)
	return parser.data


func test_client_config_parses() -> void:
	var data: Dictionary = _json(FIXTURES.path_join("openapi/ClientConfig.json")) as Dictionary
	var config: ClientConfig = ClientConfig.from_dict(data)
	assert_object(config).is_not_null()
	assert_str(config.min_client_version).is_not_empty()
	assert_bool(config.maintenance_active).is_false()
	assert_array(Array(config.supported_locales)).contains(["vi-VN"])
	assert_object(ClientConfig.from_dict({"maintenance": {"active": true}})).is_null()


func test_problem_parses_and_maps_to_a_message() -> void:
	var problem: ApiProblem = ApiProblem.from_dict(_json(FIXTURES.path_join("openapi/Problem.json")) as Dictionary)
	assert_object(problem).is_not_null()
	assert_str(problem.code).is_not_empty()
	assert_bool(problem.message().begins_with("ui.")).is_false()
	assert_object(ApiProblem.from_dict({"title": "x"})).is_null()


func test_every_example_document_parses_and_localized_text_is_pickable() -> void:
	var manifest: Dictionary = (_json(FIXTURES.path_join("manifest.json")) as Dictionary)["fixtures"] as Dictionary
	var examples: int = 0
	for rel: String in manifest.keys():
		if not rel.begins_with("examples/"):
			continue
		examples += 1
		var data: Variant = _json(FIXTURES.path_join(rel))
		assert_bool(data is Dictionary).override_failure_message(rel).is_true()
		for text: Dictionary in _localized_texts(data):
			for locale: String in ["vi-VN", "en-US"]:
				assert_str(L10n.pick(text, locale)).override_failure_message("%s %s" % [rel, text]).is_not_empty()
	assert_int(examples).is_greater_equal(5)


func test_fixture_manifest_matches_files() -> void:
	var manifest: Dictionary = (_json(FIXTURES.path_join("manifest.json")) as Dictionary)["fixtures"] as Dictionary
	for rel: String in manifest.keys():
		var bytes: PackedByteArray = FileAccess.get_file_as_bytes(FIXTURES.path_join(rel))
		var ctx: HashingContext = HashingContext.new()
		ctx.start(HashingContext.HASH_SHA256)
		ctx.update(bytes)
		assert_str(ctx.finish().hex_encode()).override_failure_message(rel).is_equal(String((manifest[rel] as Dictionary)["sha256"]))


func test_handled_error_codes_exist_in_spec() -> void:
	var spec_path: String = ProjectSettings.globalize_path("res://").path_join(SPEC_RELATIVE).simplify_path()
	assert_bool(FileAccess.file_exists(spec_path)).override_failure_message(spec_path).is_true()
	var spec: String = FileAccess.get_file_as_string(spec_path)
	var block_start: int = spec.find("    ProblemCode:")
	assert_int(block_start).is_greater(0)
	var block_end: int = spec.find("\n    Problem", block_start + 1)
	var block: String = spec.substr(block_start, block_end - block_start if block_end > 0 else -1)
	for key: String in L10n.ERROR_KEYS:
		if key == L10n.ERROR_GENERIC:
			continue
		var code: String = key.trim_prefix(L10n.ERROR_PREFIX)
		assert_bool(block.contains("- %s\n" % code)).override_failure_message(code).is_true()


## Dictionaries shaped like `localized_text` ({vi, en} only) anywhere in the document.
static func _localized_texts(value: Variant) -> Array[Dictionary]:
	var out: Array[Dictionary] = []
	if value is Dictionary:
		var dict: Dictionary = value as Dictionary
		var keys: Array = dict.keys()
		var language_keys: bool = keys.all(func(k: Variant) -> bool: return String(k) in ["vi", "en"])
		var string_values: bool = dict.values().all(func(v: Variant) -> bool: return v is String)
		if not keys.is_empty() and language_keys and string_values:
			out.append(dict)
		else:
			for v: Variant in dict.values():
				out.append_array(_localized_texts(v))
	elif value is Array:
		for item: Variant in (value as Array):
			out.append_array(_localized_texts(item))
	return out
