extends GdUnitTestSuite
## T006 / T007 (F110 contracts §1, §3; GODOT_ARCHITECTURE §12, GAME_NETWORKING §9): every F110 contract fixture
## generated by tools/gen_fixtures.mjs parses into its typed model (`from_dict` keeps only the known fields, a missing
## required field drops the item): BossSummary, BossEncounter (+ my_questions), BossQuestion, QuestStepClues,
## QuestStepRoles, QuestPartyStepProgress / QuestProgress.party_progress, PlayerCard (+ title), FriendRequest,
## FriendCode, PlayerRelation, `listFriends.200`, and the AsyncAPI samples of `boss.*`, `quest.roles.assigned`,
## `quest.clue.shared`, `quest.progress.updated` (`party_progress`) and `presence.friend.updated`.

const SELF: String = "00000000-0000-4000-8000-000000000001"


func _o(name: String) -> Dictionary:
	return F110Fixtures.openapi(name)


func _a(type: String) -> Dictionary:
	return F110Fixtures.asyncapi("%s.sample" % type)["payload"] as Dictionary


func test_boss_openapi_fixtures_parse() -> void:
	var b: BossSummary = BossSummary.from_dict(_o("BossSummary"))
	assert_object(b).is_not_null()
	assert_bool(b.allows_solo()).is_true()
	var e: BossEncounterModel = BossEncounterModel.from_dict(_o("BossEncounter"))
	assert_object(e).is_not_null()
	assert_str(e.status).is_equal("lobby")
	assert_int(e.members.size()).is_equal(1)
	var q: BossQuestionModel = BossQuestionModel.from_rest(_o("BossQuestion"), e.encounter_id, e.phase_id)
	assert_object(q).is_not_null()
	assert_object(q.render).is_not_null()
	# A summary without its required title is dropped.
	var broken: Dictionary = _o("BossSummary")
	broken.erase("title")
	assert_object(BossSummary.from_dict(broken)).is_null()


func test_coop_quest_openapi_fixtures_parse() -> void:
	var store: CoopQuestStore = CoopQuestStore.new()
	var clues: Dictionary = _o("QuestStepClues")
	store.set_clues(clues)
	assert_int(store.clues(String(clues["quest_id"]), String(clues["step_id"])).size()).is_equal(1)
	var roles: Dictionary = _o("QuestStepRoles")
	store.apply_roles(roles, SELF)
	assert_int(store.roles(String(roles["quest_id"]), String(roles["step_id"])).size()).is_equal(1)
	var p: PartyQuestProgressModel = PartyQuestProgressModel.from_dict("q", _o("QuestPartyStepProgress"))
	assert_object(p).is_not_null()
	var progress: Dictionary = _o("QuestProgress")
	var model: QuestModel = QuestModel.new()
	model.quest_id = String(progress["quest_id"])
	model.apply_progress(progress)
	assert_int(model.party_progress.size()).is_equal(1)


func test_social_openapi_fixtures_parse() -> void:
	var card: FriendModel = FriendModel.from_card(_o("PlayerCard"))
	assert_object(card).is_not_null()
	assert_str(card.display_title()).is_equal("sample")
	assert_int(FriendModel.list_from(_o("listFriends.200")["data"]).size()).is_equal(3)
	assert_object(FriendRequestModel.from_dict(_o("FriendRequest"), FriendRequestModel.DIRECTION_INCOMING)).is_not_null()
	assert_object(FriendRequestModel.from_dict(_o("FriendRequest"), FriendRequestModel.DIRECTION_OUTGOING)).is_not_null()
	var code: Dictionary = _o("FriendCode")
	code["code"] = "AB12CD"
	assert_object(FriendCodeModel.from_dict(code)).is_not_null()
	code["code"] = "ab"
	assert_object(FriendCodeModel.from_dict(code)).is_null()
	assert_object(RelationModel.from_dict(_o("PlayerRelation"), RelationModel.KIND_BLOCK)).is_not_null()


func test_boss_asyncapi_samples_apply_to_the_store() -> void:
	var store: BossStore = BossStore.new()
	var e: BossEncounterModel = BossEncounterModel.new()
	e.encounter_id = String(_a("boss.encounter.updated")["encounter_id"])
	store.apply_snapshot(e)
	for type: String in ["boss.encounter.updated", "boss.phase.started", "boss.question.assigned", "boss.answer.evaluated",
			"boss.phase.completed", "boss.encounter.ended"]:
		var p: Dictionary = _a(type)
		if type == "boss.encounter.updated":
			p["state_version"] = 1
		assert_bool(store.apply_message(type, p)).override_failure_message("%s not applied" % type).is_true()
	assert_str(store.result.get("outcome", "")).is_equal("defeated")
	# Client commands of the contract carry their required fields.
	for type: String in ["boss.encounter.ready", "boss.answer.submit"]:
		var c: Dictionary = F110Fixtures.asyncapi("%s.sample" % type)
		assert_str(String(c["type"])).is_equal(type)
		assert_bool((c["payload"] as Dictionary).has("encounter_id")).is_true()


func test_quest_and_presence_asyncapi_samples_parse() -> void:
	var store: CoopQuestStore = CoopQuestStore.new()
	var roles: Dictionary = _a("quest.roles.assigned")
	store.apply_roles(roles, SELF)
	assert_int(store.roles(String(roles["quest_id"]), String(roles["step_id"])).size()).is_equal(1)
	assert_bool(store.is_new_share(_a("quest.clue.shared"))).is_true()
	var progress: Dictionary = _a("quest.progress.updated")
	assert_bool(store.apply_progress(String(progress["quest_id"]), progress["party_progress"])).is_true()
	var presence: Dictionary = _a("presence.friend.updated")
	assert_bool(Uuid.is_valid(String(presence["user_id"]))).is_true()
	assert_bool(String(presence["status"]) in FriendModel.PRESENCES).is_true()
