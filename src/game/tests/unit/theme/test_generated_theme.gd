extends GdUnitTestSuite
## F005 T015 (F005-AC-02, TC-UI-001): resources generated by `make design-tokens` load in Godot,
## every density has its Theme and UiTokens / Art3dTokens compile with static types.
## Runs in the Godot lane once F060 adds the project and GdUnit4 (not run by F005: no Godot in that environment).


func test_base_theme_loads() -> void:
	var theme: Theme = load(UiTokens.BASE_THEME_PATH) as Theme
	assert_object(theme).is_not_null()
	assert_int(theme.default_font_size).is_equal(UiTokens.DENSITY_FONT_BASE[UiTokens.BASE_DENSITY])
	assert_object(theme.default_font).is_not_null()


func test_every_density_has_a_theme() -> void:
	for band: String in UiTokens.DENSITY_BANDS:
		var theme: Theme = load(UiTokens.THEME_PATHS[band]) as Theme
		assert_object(theme).is_not_null()
		assert_int(theme.default_font_size).is_equal(UiTokens.DENSITY_FONT_BASE[band])
		assert_bool(theme.has_stylebox("normal", "Button")).is_true()
		assert_bool(theme.has_color("font_color", "Label")).is_true()
		assert_str(String(theme.get_type_variation_base("HeadingLabel"))).is_equal("Label")


func test_high_contrast_theme_loads() -> void:
	var theme: Theme = load(UiTokens.HIGH_CONTRAST_THEME_PATH) as Theme
	assert_object(theme).is_not_null()
	assert_that(theme.get_color("font_color", "Label")).is_equal(Color(0, 0, 0, 1))


func test_ui_tokens_values() -> void:
	assert_float(UiTokens.TEXT_EXPANSION_ALLOWANCE).is_equal_approx(1.35, 0.0001)
	assert_int(UiTokens.DENSITY_FONT_BASE["g1_3"]).is_greater_equal(24)
	assert_bool(UiTokens.DOMAIN_COLORS.has("color.subject.math")).is_true()


func test_art_resources_load() -> void:
	for zone: String in Art3dTokens.ENVIRONMENT_PATHS:
		var env: Environment = load(Art3dTokens.ENVIRONMENT_PATHS[zone]) as Environment
		assert_object(env).is_not_null()
		assert_bool(env.fog_enabled).is_true()
	for kind: String in Art3dTokens.VFX_GRADIENT_PATHS:
		var gradient: Gradient = load(Art3dTokens.VFX_GRADIENT_PATHS[kind]) as Gradient
		assert_object(gradient).is_not_null()
		assert_int(gradient.get_point_count()).is_greater_equal(2)
