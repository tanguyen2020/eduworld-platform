; EduWorld game client (F060). Godot version is pinned in .godot-version (minor) and in config/features.
; Autoload order follows GODOT_ARCHITECTURE §4 (AuthService #5 / ApiClient #6: F061, RealtimeClient: F092,
; ContentCache: later features insert themselves at their numbered position; QualityManager #12: F062).

config_version=5

[application]

config/name="EduWorld"
config/description="EduWorld game client"
run/main_scene="res://scenes/bootstrap/Boot.tscn"
config/features=PackedStringArray("4.7", "Mobile")
; F062-AC-17: QualityManager writes the renderer chosen for the next run (fallback to Compatibility) here.
config/project_settings_override="user://renderer_override.cfg"

[audio]

buses/default_bus_layout="res://resources/audio/bus_layout.tres"

[autoload]

Config="*res://scripts/core/config.gd"
Log="*res://scripts/core/logger.gd"
EventBus="*res://scripts/core/event_bus.gd"
AppState="*res://scripts/core/app_state.gd"
AuthService="*res://scripts/authentication/auth_service.gd"
ApiClient="*res://scripts/networking/api_client.gd"
RealtimeClient="*res://scripts/networking/realtime_client.gd"
SceneRouter="*res://scripts/core/scene_router.gd"
AudioDirector="*res://scripts/core/audio_director.gd"
Settings="*res://scripts/core/settings.gd"
QualityManager="*res://scripts/core/quality_manager.gd"
ActivityRendererRegistry="*res://scripts/learning/activity_renderer_registry.gd"

[debug]

gdscript/warnings/exclude_addons=true
gdscript/warnings/untyped_declaration=2
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_cast=1
gdscript/warnings/unsafe_call_argument=1

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/eduworld_platform/plugin.cfg")

[eduworld]

config/env="local"
config/env.eduworld_dev="dev"
config/env.eduworld_staging="staging"
config/env.eduworld_production="production"
log/ring_buffer_size=500
i18n/supported_locales=PackedStringArray("vi-VN", "en-US")
i18n/default_locale="vi-VN"
i18n/pseudo_locale="xx-PS"
i18n/pseudo_locale_path="res://locale/xx_PS.po"
ui/pre_bootstrap_density="g1_3"
device/config_path="user://device.cfg"
device/shared_device_default/android=false
device/shared_device_default/ios=false
device/shared_device_default/web=true
device/shared_device_default/other=true

[gui]

theme/custom="res://resources/ui/theme/eduworld_theme_g1_3.tres"

[input]

; F062 (STUDENT_GAME_UX §4): WASD/arrows move, Space jump, E interact, J journal, right mouse drag rotates the
; camera, wheel zooms. Touch: joystick + swipe (scenes/ui/hud), tap-to-move for g1_3 (scripts/player/tap_to_move.gd).
; F070: T emote wheel (+ touch button, scenes/character/EmoteWheel.tscn), I wardrobe (STUDENT_GAME_UX §4.1).
move_forward={
"deadzone": 0.2,
