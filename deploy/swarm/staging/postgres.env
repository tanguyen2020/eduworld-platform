# PostgreSQL/Patroni nodes — non-secret configuration of staging (F130 T014). pgBackRest repo location (same repo as
# backup-tools); passwords and backup keys come from Docker secrets (patroni-start).
PGDATA=/var/lib/postgresql/data/pgdata
PATRONI_SCOPE=eduworld
PGBACKREST_STANZA=eduworld
PGBACKREST_REPO1_S3_ENDPOINT=backup-s3.offsite.staging.eduworld.example
PGBACKREST_REPO1_S3_BUCKET=eduworld-backups-staging
PGBACKREST_REPO1_S3_REGION=vn-2
TZ=UTC
