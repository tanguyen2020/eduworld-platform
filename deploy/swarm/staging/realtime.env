# realtime — non-secret configuration of staging (F130). No database, no module credential (DEPLOYMENT §13).
EW_ENV=staging
EW_LOG_FORMAT=json
EW_LOG_LEVEL=info
EW_HTTP_ADDR=:8106
EW_ADMIN_ADDR=:9090
EW_SHUTDOWN_DRAIN_DELAY=5s
EW_VALKEY_ADDR=valkey-cache:6379
EW_VALKEY_USERNAME=realtime
EW_NATS_URLS=nats://nats-1:4222,nats://nats-2:4222,nats://nats-3:4222
EW_CORS_ALLOWED_ORIGINS=https://portal.staging.eduworld.example,https://play.staging.eduworld.example
EW_REALTIME_PUBLIC_URL=wss://api.staging.eduworld.example/realtime/v1
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
