# Backup jobs of staging run by supercronic in backup-tools (F130 T033; BACKUP_RECOVERY §3.2, §3.4, §6; research R3).
# Times are ICT (CRON_TZ). The monthly restore test is NOT here: it needs the restore credential, issued only for the
# run (`make restore-test`, scripts/backup/run-restore-test.sh, F130-AC-15).
CRON_TZ=Asia/Ho_Chi_Minh
# Full backup Sunday 01:00, differential the other days 01:00 (each run ends with `pgbackrest check`).
0 1 * * 0 /opt/eduworld/backup/pg_backup.sh full
0 1 * * 1-6 /opt/eduworld/backup/pg_backup.sh diff
# Independent daily `pgbackrest check` (WAL archiving stuck → status 0).
0 12 * * * /opt/eduworld/backup/pg_check.sh
# Weekly logical dump of every module database (Sunday, after the full backup).
0 3 * * 0 /opt/eduworld/backup/pg_logical_dump.sh
# Object storage: daily off-cluster copy; replication lag probe of the private bucket every 5 minutes; versioning check.
0 2 * * * /opt/eduworld/backup/object_storage_backup.sh
*/5 * * * * /opt/eduworld/backup/object_storage_replication_check.sh
30 1 * * * /opt/eduworld/backup/object_storage_setup.sh --check-only
# APISIX etcd snapshot and realm export without secrets, daily.
30 2 * * * /opt/eduworld/backup/etcd_snapshot.sh
45 2 * * * /opt/eduworld/backup/keycloak_export.sh
