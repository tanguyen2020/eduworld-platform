# core-api — non-secret configuration of staging (F130, LOCAL_DEVELOPMENT §4 is the variable table).
# Secrets are never here: they come from Docker secrets through *_FILE in app.stack.yml (check-secret-refs.mjs fails
# on any secret-looking value). Domain names below are the staging placeholders of DEPLOYMENT §9 (staging.eduworld.example).
EW_ENV=staging
EW_LOG_FORMAT=json
EW_LOG_LEVEL=info
EW_HTTP_ADDR=:8100
EW_ADMIN_ADDR=:9090
EW_SHUTDOWN_DRAIN_DELAY=5s
EW_HTTP_SHUTDOWN_TIMEOUT=30s
EW_VALKEY_ADDR=valkey-cache:6379
EW_VALKEY_USERNAME=core-api
EW_NATS_URLS=nats://nats-1:4222,nats://nats-2:4222,nats://nats-3:4222
EW_OIDC_ISSUERS=https://auth.staging.eduworld.example/realms/eduworld
EW_OIDC_AUDIENCE=eduworld-api
EW_OIDC_ALLOWED_AZP=eduworld-game-backend,eduworld-portal
EW_KC_ADMIN_BASE_URL=http://keycloak:8080/admin/realms/eduworld
EW_KC_ADMIN_CLIENT_ID=svc-identity
EW_KC_PORTAL_CLIENT_ID=eduworld-portal
EW_KC_GAME_CLIENT_ID=eduworld-game-backend
EW_OPENAPI_SPEC=/app/specs/openapi/eduworld-api.v1.yaml
EW_PORTAL_MENU_CATALOG=/app/specs/portal/menu-catalog.yaml
EW_PORTAL_BASE_URL=https://portal.staging.eduworld.example
EW_GAME_LOGIN_URL=https://api.staging.eduworld.example/api/v1/auth/game/login
EW_REALTIME_PUBLIC_URL=wss://api.staging.eduworld.example/realtime/v1
EW_GAME_MIN_CLIENT_VERSION=0.1.0
EW_SMTP_HOST=smtp-relay.staging.eduworld.example
EW_SMTP_PORT=587
EW_SMTP_FROM=no-reply@staging.eduworld.example
EW_SMTP_USERNAME=eduworld-mailer
EW_S3_ENDPOINT=http://storage-s3:8333
EW_S3_REGION=vn-1
EW_S3_FORCE_PATH_STYLE=true
EW_CDN_BASE_URL=https://cdn.staging.eduworld.example
EW_MEDIA_SCAN=clamd://clamav:3310
EW_SIS_SECRETS_DIR=/run/secrets
EW_PROMETHEUS_URL=http://prometheus:9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=1.0
