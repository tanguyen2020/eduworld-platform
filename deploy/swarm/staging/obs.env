# Observability stack — non-secret configuration of staging (F131 T017; MONITORING §1, §8, §9). Secrets (on-call
# channel URLs, SMTP password, Grafana/Keycloak client secret, GlitchTip, QA probe password) come from Docker secrets
# through *_FILE in obs.stack.yml. Domain names are the staging placeholders of DEPLOYMENT §9.
# Alertmanager (rendered into alertmanager.yml by alertmanager-entrypoint.sh)
EW_ALERT_SMTP_SMARTHOST=smtp.staging.eduworld.example:587
EW_ALERT_SMTP_FROM=alerts@staging.eduworld.example
EW_ALERT_SMTP_USERNAME=alerts
EW_ALERT_EMAIL_TO=oncall@staging.eduworld.example
EW_ALERT_EXTERNAL_URL=https://alertmanager.internal.staging.eduworld.example
# Grafana: Keycloak login only (client eduworld-ops-tools, realm eduworld; platform roles; no MFA — ADR-0094).
GF_SERVER_ROOT_URL=https://grafana.internal.staging.eduworld.example
GF_AUTH_DISABLE_LOGIN_FORM=true
GF_AUTH_ANONYMOUS_ENABLED=false
GF_AUTH_GENERIC_OAUTH_ENABLED=true
GF_AUTH_GENERIC_OAUTH_NAME=Keycloak
GF_AUTH_GENERIC_OAUTH_CLIENT_ID=eduworld-ops-tools
GF_AUTH_GENERIC_OAUTH_SCOPES=openid profile email roles
GF_AUTH_GENERIC_OAUTH_AUTH_URL=https://auth.staging.eduworld.example/realms/eduworld/protocol/openid-connect/auth
GF_AUTH_GENERIC_OAUTH_TOKEN_URL=https://auth.staging.eduworld.example/realms/eduworld/protocol/openid-connect/token
GF_AUTH_GENERIC_OAUTH_API_URL=https://auth.staging.eduworld.example/realms/eduworld/protocol/openid-connect/userinfo
GF_AUTH_GENERIC_OAUTH_USE_PKCE=true
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_PATH=contains(realm_access.roles[*], 'system_admin') && 'Admin' || contains(realm_access.roles[*], 'platform_ops') && 'Editor' || contains(realm_access.roles[*], 'platform_staff') && 'Viewer'
GF_AUTH_GENERIC_OAUTH_ROLE_ATTRIBUTE_STRICT=true
GF_AUTH_GENERIC_OAUTH_ALLOW_ASSIGN_GRAFANA_ADMIN=false
GF_USERS_ALLOW_SIGN_UP=false
GF_SERVER_ROUTER_LOGGING=true
GF_LOG_MODE=console
GF_LOG_CONSOLE_FORMAT=json
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
# glitchtip-bridge (GitHub Issues of the repository)
EW_GITHUB_REPO=tanguyen2020/eduworld-platform
# synthetic-probe (QA tenant, TEST_STRATEGY §4; the QA student only exists in staging/production)
EW_PROBE_BASE_URL=https://api.staging.eduworld.example
EW_PROBE_USERNAME=hs.qa.probe
EW_PROBE_DEVICE_ID=0b3f6a4e-5c1d-4f2a-9e8b-7d6c5b4a3f21
EW_PROBE_CLIENT_VERSION=1.0.0
EW_PROBE_PLATFORM=windows
