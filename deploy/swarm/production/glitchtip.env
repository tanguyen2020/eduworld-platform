# GlitchTip (self-hosted error tracking, MONITORING §9, ADR-0023) — non-secret configuration of production. SECRET_KEY and
# the database password come from Docker secrets (entrypoint of obs.stack.yml). Data stays on node `ops` (same region as
# production, DATA_PRIVACY §5). No self sign-up: accounts via Keycloak social login configured in the GlitchTip admin.
GLITCHTIP_DOMAIN=https://glitchtip.internal.eduworld.example
DEFAULT_FROM_EMAIL=glitchtip@eduworld.example
REDIS_URL=redis://glitchtip-valkey:6379/0
ENABLE_USER_REGISTRATION=false
ENABLE_ORGANIZATION_CREATION=false
GLITCHTIP_MAX_EVENT_LIFE_DAYS=30
CELERY_WORKER_AUTOSCALE=1,3
