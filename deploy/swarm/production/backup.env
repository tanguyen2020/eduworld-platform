# backup-tools — non-secret configuration of production (F130 US3). Endpoints are placeholders of the hosting contract
# (OQ-10: VM cloud in Việt Nam; the backup repo is on S3 OUTSIDE the main infrastructure, other account/site). Keys,
# cipher passphrase, client certificates, .pgpass: Docker secrets only.
TZ=Asia/Ho_Chi_Minh
EW_BACKUP_ENV=production
METRIC_DIR=/var/lib/node_exporter/textfile
PGBACKREST_STANZA=eduworld
PGBACKREST_REPO1_S3_ENDPOINT=backup-s3.offsite.eduworld.example
PGBACKREST_REPO1_S3_BUCKET=eduworld-backups-production
PGBACKREST_REPO1_S3_REGION=vn-2
EW_BACKUP_REPO_URL=https://backup-s3.offsite.eduworld.example
EW_BACKUP_PG_HOST=pg-router
EW_BACKUP_PG_PORT=5433
EW_BACKUP_PG_USER=backup_reader
EW_BACKUP_SOURCE_URL=http://storage-s3:8333
EW_BACKUP_SOURCE_REGION=vn-1
EW_BACKUP_OFFSITE_URL=https://backup-s3.offsite.eduworld.example
EW_BACKUP_OFFSITE_REGION=vn-2
EW_BACKUP_OFFSITE_BUCKET=eduworld-objects-offsite-production
EW_BACKUP_BUCKETS=ew-media-public ew-media-private ew-game-bundles ew-exports ew-sis-imports
EW_REPLICATED_BUCKETS=ew-media-private
EW_REPLICA_URL=https://s3.site2.eduworld.example
EW_RPO_SECONDS=300
EW_ETCD_ENDPOINTS=http://etcd-apisix-1:2379,http://etcd-apisix-2:2379,http://etcd-apisix-3:2379
EW_KC_URL=http://keycloak:8080
EW_KC_REALM=eduworld
EW_RESTORE_REPORT_DIR=/restore/reports
EW_RESTORE_MAX_SECONDS=7200
# nats CLI of the consumer resets (reset-consumers.sh uses /run/secrets/ops_nats_creds, attached to one-off jobs only).
NATS_URL=nats://nats-1:4222,nats://nats-2:4222,nats://nats-3:4222
