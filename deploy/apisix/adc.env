# ADC (API7 declarative CLI) used by scripts/deploy/apisix-sync.sh (CI job apisix:sync) and
# deploy/apisix/scripts/validate-adc.sh — one pinned version (F130 T052, DEPLOYMENT §5). Change both lines together;
# the digest is the multi-arch index digest of the Docker Hub image. ADC 0.31.x supports APISIX 3.2–3.17 (backend
# apisix, traditional/etcd mode).
ADC_VERSION=0.31.0
ADC_IMAGE=api7/adc:0.31.0@sha256:230629a6ccd624e100ad5e46870456a5901418a7a0ed1f8022cb27b475167767
