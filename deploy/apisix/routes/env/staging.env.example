# Staging template (domain placeholder eduworld.example, OQ-10): copy to staging.env in the deploy pipeline.
# Values per environment for scripts/render.mjs; the login HMAC key comes from the gateway environment.
EW_UPSTREAM_CORE_API=tasks.core-api:8100
EW_UPSTREAM_REALTIME=tasks.realtime:8106
EW_OIDC_DISCOVERY=https://auth.staging.eduworld.example/realms/eduworld/.well-known/openid-configuration
EW_OIDC_ISSUERS=https://auth.staging.eduworld.example/realms/eduworld
EW_OIDC_AUDIENCE=eduworld-api
EW_PORTAL_HOST=portal.staging.eduworld.example
EW_CORS_ALLOWED_ORIGINS=https://portal.staging.eduworld.example
EW_ADMIN_CIDRS=10.20.0.0/16
EW_RATE_LOGIN_DEVICE_PER_MIN=10
EW_RATE_LOGIN_USER_PER_MIN=10
EW_RATE_LOGIN_GLOBAL_PER_SEC=120
EW_RATE_REFRESH_DEVICE_PER_MIN=30
EW_RATE_PORTAL_DEVICE_PER_MIN=10
EW_RATE_PORTAL_USER_PER_MIN=10
EW_RATE_PORTAL_GLOBAL_PER_SEC=20
EW_REALTIME_CONN_PER_IP=200
EW_RATE_API_READ_PER_MIN=300
EW_RATE_API_WRITE_PER_MIN=60
EW_RATE_SESSION_PER_MIN=10
EW_RATELIMIT_VALKEY_HOST=tasks.valkey-ratelimit
EW_RATELIMIT_VALKEY_PORT=6379
EW_TLS=true
EW_OTEL_COLLECTOR=otel-collector:4318
