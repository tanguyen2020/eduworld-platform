{
  "component": {
    "button": {
      "primary": {
        "bg": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Primary button background." },
        "bg_pressed": { "$type": "color", "$value": "{color.accent.primary_pressed}", "$description": "Primary button pressed." },
        "text": {
          "$type": "color",
          "$value": "{color.text.on_accent}",
          "$description": "Primary button label.",
          "$extensions": { "eduworld": { "contrastWith": [
            { "token": "component.button.primary.bg", "level": "normal" },
            { "token": "component.button.primary.bg_pressed", "level": "normal" }
          ] } }
        },
        "radius": { "$type": "dimension", "$value": "{size.radius.16}", "$description": "Primary button corner radius." }
      },
      "secondary": {
        "bg": { "$type": "color", "$value": "{palette.sky.100}", "$description": "Secondary button and IconButton background: light blue, ink outline and bottom edge (F114)." },
        "border": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Secondary button border." },
        "text": {
          "$type": "color",
          "$value": "{color.text.primary}",
          "$description": "Secondary button label.",
          "$extensions": { "eduworld": { "contrastWith": [
            { "token": "component.button.secondary.bg", "level": "normal" },
            { "token": "component.button.secondary.bg_hover", "level": "normal" },
            { "token": "component.button.secondary.bg_pressed", "level": "normal" }
          ] } }
        },
        "bg_hover": { "$type": "color", "$value": "{palette.sky.100}", "$description": "Outlined button (IconButton, ChoiceChip, TextButton) background on hover." },
        "bg_pressed": { "$type": "color", "$value": "{palette.sky.200}", "$description": "Outlined button background while pressed / toggled on." }
      },
      "border_width": { "$type": "dimension", "$value": "{size.border.3}", "$description": "Button border width." },
      "danger": {
        "bg": { "$type": "color", "$value": "{palette.red.700}", "$description": "DangerButton background: only to leave or end (window close, Đăng xuất), never for learning feedback or Cancel (F114)." },
        "bg_pressed": { "$type": "color", "$value": "{palette.red.800}", "$description": "DangerButton background on hover / while pressed (F114)." },
        "text": {
          "$type": "color",
          "$value": "{color.text.on_accent}",
          "$description": "DangerButton label and icon (F114).",
          "$extensions": { "eduworld": { "contrastWith": [
            { "token": "component.button.danger.bg", "level": "normal" },
            { "token": "component.button.danger.bg_pressed", "level": "normal" }
          ] } }
        }
      }
    },
    "panel": {
      "bg": { "$type": "color", "$value": "{color.surface.panel}", "$description": "Panel background." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Window frame outline and bottom edge (tier 1, F114)." },
      "radius": { "$type": "dimension", "$value": "{size.radius.24}", "$description": "Panel corner radius." },
      "padding": { "$type": "dimension", "$value": "{size.space.24}", "$description": "Panel inner padding." }
    },
    "quest_card": {
      "bg": { "$type": "color", "$value": "{color.surface.card}", "$description": "Quest card background." },
      "radius": { "$type": "dimension", "$value": "{size.radius.16}", "$description": "Quest card radius." }
    },
    "hint_button": {
      "bg": { "$type": "color", "$value": "{color.feedback.hint}", "$description": "HintButton background." },
      "text": {
        "$type": "color",
        "$value": "{color.text.on_accent}",
        "$description": "HintButton label and level counter.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.hint_button.bg", "level": "normal" }] } }
      }
    },
    "voice_caption": {
      "bg": { "$type": "color", "$value": "{palette.sky.100}", "$description": "VoiceCaption subtitle box background (g1_3, PED-07)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "VoiceCaption subtitle text.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.voice_caption.bg", "level": "normal" }] } }
      }
    },
    "exam_clock": {
      "warning_text": {
        "$type": "color",
        "$value": "{color.feedback.incorrect}",
        "$description": "Exam countdown in the last 5 and 1 minutes: one steady, gentle warning colour, never blinking (STUDENT_GAME_UX_LEARNING §9.4, F064-AC-04).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "color.surface.panel", "level": "normal" },
          { "token": "color.surface.panel_alt", "level": "normal" }
        ] } }
      }
    },
    "badge_xp": {
      "bg": { "$type": "color", "$value": "{color.accent.reward}", "$description": "XP / level badge background." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "XP / level badge text.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.badge_xp.bg", "level": "normal" }] } }
      }
    },
    "progress": {
      "fill": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Progress bar fill." },
      "track": { "$type": "color", "$value": "{palette.sky.200}", "$description": "Progress bar track." }
    },
    "hud": {
      "bg": { "$type": "color", "$value": "{color.surface.hud}", "$description": "HUD background." },
      "text": {
        "$type": "color",
        "$value": "{color.text.on_accent}",
        "$description": "HUD text.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.hud.bg", "level": "normal" }] } }
      }
    },
    "icon": {
      "size": { "$type": "dimension", "$value": "{size.icon.32}", "$description": "Button icon size (icon_max_width of IconButton, ChoiceChip, TextButton; icons beside messages)." },
      "checkbox_size": { "$type": "dimension", "$value": "{size.icon.40}", "$description": "CheckBox box size (drawn by the generated checkbox icons)." },
      "primary": {
        "$type": "color",
        "$value": "{color.accent.primary}",
        "$description": "Icon colour on light surfaces (globe, eye, help, info, checkbox).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "color.surface.panel", "level": "graphic" },
          { "token": "color.surface.panel_alt", "level": "graphic" },
          { "token": "component.button.secondary.bg_hover", "level": "graphic" },
          { "token": "component.button.secondary.bg_pressed", "level": "graphic" }
        ] } }
      },
      "on_accent": { "$type": "color", "$value": "{color.text.on_accent}", "$description": "Icon colour on the accent fill (check mark of a selected chip / checked box)." },
      "alert": {
        "$type": "color",
        "$value": "{color.feedback.incorrect}",
        "$description": "Alert icon beside an InlineError message (the icon, not only the colour, tells it is an error).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.inline_error.bg", "level": "graphic" }] } }
      }
    },
    "chip": {
      "selected_bg": { "$type": "color", "$value": "{color.accent.primary}", "$description": "ChoiceChip background when selected (plus a check icon)." },
      "selected_text": {
        "$type": "color",
        "$value": "{color.text.on_accent}",
        "$description": "ChoiceChip label when selected.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.chip.selected_bg", "level": "normal" }] } }
      }
    },
    "choice_chip": {
      "bg": { "$type": "color", "$value": "{palette.white}", "$description": "ChoiceChip not chosen: white with ink words, no tick (F114)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "ChoiceChip label when not chosen (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.choice_chip.bg", "level": "normal" },
          { "token": "component.button.secondary.bg_hover", "level": "normal" }
        ] } }
      },
      "selected_bg": { "$type": "color", "$value": "{palette.yellow.400}", "$description": "ChoiceChip chosen: bright yellow, ink words and a tick icon. Yellow = chosen value, blue = action / place (F114, replaces the F096 accent fill)." },
      "selected_text": {
        "$type": "color",
        "$value": "{palette.ink.900}",
        "$description": "ChoiceChip label and tick when chosen (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.choice_chip.selected_bg", "level": "normal" }
        ] } }
      }
    },
    "section_tag": {
      "bg": { "$type": "color", "$value": "{palette.yellow.100}", "$description": "Section tag pill in a panel (SectionTag, F114)." },
      "text": {
        "$type": "color",
        "$value": "{palette.yellow.900}",
        "$description": "Section tag words: capitals, bold, the band small font (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.section_tag.bg", "level": "normal" }
        ] } }
      },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Section tag ink outline (F114)." }
    },
    "count_badge": {
      "bg": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Unread count pill beside the HUD bell and the word \"Mới\" on an unread inbox row (CountBadge, tier 2 info item, F123). The count / word carries the state, never the colour alone." },
      "text": {
        "$type": "color",
        "$value": "{color.text.on_accent}",
        "$description": "Unread count / \"Mới\" words: bold, the band small font (F123).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.count_badge.bg", "level": "normal" }
        ] } }
      },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Count badge thin ink outline (tier 2, F123)." }
    },
    "party_card": {
      "bg": { "$type": "color", "$value": "{palette.white}", "$description": "Party member card (PartyMemberCard, tier 2 info card, F102): white on the cream window so each friend stands out." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Party member card thin ink outline (tier 2, F102)." },
      "away_bg": { "$type": "color", "$value": "{palette.ink.200}", "$description": "Card of a member who lost the connection (PartyMemberCardAway, F102-AC-13): faded grey, always with the words \"Đang kết nối lại…\" and the wifi-off icon — never the colour alone." },
      "away_border": { "$type": "color", "$value": "{palette.ink.600}", "$description": "Outline of the faded card of a member who lost the connection (F102)." },
      "away_text": {
        "$type": "color",
        "$value": "{palette.ink.700}",
        "$description": "Words on the faded card of a member who lost the connection (PartyAwayLabel, F102).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.party_card.away_bg", "level": "normal" }
        ] } }
      }
    },
    "warning_banner": {
      "bg": { "$type": "color", "$value": "{palette.yellow.100}", "$description": "Yellow banner of a temporary state (WarningBannerPanel, tier 2, F102): \"Đang kết nối lại…\" while offline, \"Trưởng nhóm đang kết nối lại…\" in the party lobby. Always with an icon and words." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Warning banner thin ink outline (tier 2, F102)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Warning banner words (WarningBannerLabel, F102).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.warning_banner.bg", "level": "normal" }
        ] } }
      }
    },
    "countdown": {
      "font_size": { "$type": "dimension", "$value": "{size.font.96}", "$description": "Party start countdown 3-2-1 (CountdownLabel, F102-AC-11), the wordmark colours and white sticker outline (component.logo.*)." }
    },
    "toggle": {
      "track_on": {
        "$type": "color",
        "$value": "{color.accent.primary}",
        "$description": "ToggleSwitch track when on; the knob sits on the right and the word Bật is written beside it (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.toggle.knob", "level": "graphic" }
        ] } }
      },
      "track_off": { "$type": "color", "$value": "{palette.ink.200}", "$description": "ToggleSwitch track when off; knob on the left, word Tắt beside it (F114)." },
      "knob": { "$type": "color", "$value": "{palette.white}", "$description": "ToggleSwitch knob, ink outline (F114)." },
      "border": {
        "$type": "color",
        "$value": "{color.outline}",
        "$description": "ToggleSwitch track and knob outline (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.toggle.track_off", "level": "graphic" },
          { "token": "color.surface.panel", "level": "graphic" }
        ] } }
      },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Words Bật / Tắt beside a ToggleSwitch (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "color.surface.panel", "level": "normal" },
          { "token": "component.button.secondary.bg_hover", "level": "normal" }
        ] } }
      }
    },
    "slider": {
      "track": { "$type": "color", "$value": "{palette.white}", "$description": "HSlider groove (volume), ink outline and bottom edge (F114)." },
      "fill": {
        "$type": "color",
        "$value": "{color.accent.primary}",
        "$description": "HSlider filled part up to the knob (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.slider.track", "level": "graphic" }
        ] } }
      }
    },
    "settings": {
      "tab_column_bg": { "$type": "color", "$value": "{palette.sky.100}", "$description": "Settings tab column: light tint of the accent, ink right border (F114)." },
      "tab_column_width": { "$type": "dimension", "$value": "{size.layout.280}", "$description": "Settings tab column width (F114); long words wrap inside it." },
      "tab_text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Words of a Settings tab that is not open (transparent tab, F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.settings.tab_column_bg", "level": "normal" },
          { "token": "component.settings.tab_hover_bg", "level": "normal" }
        ] } }
      },
      "tab_hover_bg": { "$type": "color", "$value": "{palette.sky.200}", "$description": "Settings tab under the pointer (F114)." },
      "tab_icon": {
        "$type": "color",
        "$value": "{color.accent.primary}",
        "$description": "Icon of a Settings tab that is not open (modulates the white tab icon, F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.settings.tab_column_bg", "level": "graphic" }
        ] } }
      },
      "tab_selected_bg": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Open Settings tab: accent fill, ink outline and bottom edge (blue = place, F114)." },
      "tab_selected_text": {
        "$type": "color",
        "$value": "{color.text.on_accent}",
        "$description": "Words and icon of the open Settings tab (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.settings.tab_selected_bg", "level": "normal" }
        ] } }
      },
      "title_bg": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Window title bar (CÀI ĐẶT), ink outline and hard bottom edge (F114)." },
      "title_text": {
        "$type": "color",
        "$value": "{color.text.on_accent}",
        "$description": "Window title in capitals (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.settings.title_bg", "level": "normal" }
        ] } }
      },
      "confirm_title_bg": { "$type": "color", "$value": "{palette.yellow.400}", "$description": "Confirmation dialog title bar (ĐĂNG XUẤT?), F114." },
      "confirm_title_text": {
        "$type": "color",
        "$value": "{palette.ink.900}",
        "$description": "Confirmation dialog title in capitals (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.settings.confirm_title_bg", "level": "normal" }
        ] } }
      },
      "value_bg": { "$type": "color", "$value": "{palette.white}", "$description": "Value chip beside a slider (70%), thin ink outline (F114)." },
      "value_text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Value chip words (F114).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.settings.value_bg", "level": "normal" }
        ] } }
      }
    },
    "window": {
      "pop_scale": { "$type": "number", "$value": "{number.ratio.096}", "$description": "Start scale of a window opening (0.96 to 1); no animation while Giảm chuyển động is on (F114)." },
      "pop_duration": { "$type": "duration", "$value": "{duration.base}", "$description": "Window opening duration, at most 0.2 s (F114)." }
    },
    "text_button": {
      "text": {
        "$type": "color",
        "$value": "{color.accent.primary}",
        "$description": "TextButton (flat, link-like action with an icon) label.",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "color.surface.panel", "level": "normal" },
          { "token": "component.button.secondary.bg_hover", "level": "normal" },
          { "token": "component.button.secondary.bg_pressed", "level": "normal" }
        ] } }
      }
    },
    "inline_error": {
      "bg": { "$type": "color", "$value": "{palette.red.50}", "$description": "InlineError panel background." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "InlineError panel thin ink outline (tier 2, F114); the alert icon tells it is an error." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "InlineError message text.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.inline_error.bg", "level": "normal" }] } }
      }
    },
    "info_banner": {
      "bg": { "$type": "color", "$value": "{palette.sky.100}", "$description": "InfoBanner panel background (session expired…)." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "InfoBanner panel thin ink outline (tier 2, F114)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "InfoBanner text.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.info_banner.bg", "level": "normal" }] } }
      }
    },
    "form_card": {
      "bg": { "$type": "color", "$value": "{color.surface.panel}", "$description": "Form card (LoginCard) background." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Form card / dialog frame outline and bottom edge (tier 1, F114)." },
      "shadow": { "$type": "color", "$value": "{palette.shadow.soft}", "$description": "Form card drop shadow." },
      "shadow_size": { "$type": "dimension", "$value": "{size.space.16}", "$description": "Form card drop shadow blur size." },
      "padding": { "$type": "dimension", "$value": "{size.space.20}", "$description": "Form card inner padding." },
      "width": { "$type": "dimension", "$value": "{size.layout.660}", "$description": "Form card width (S01 login card)." },
      "side_width": { "$type": "dimension", "$value": "{size.layout.280}", "$description": "Width of each side column beside the card (logo + mascot left, language right) so the card stays centred." }
    },
    "speech_bubble": {
      "bg": { "$type": "color", "$value": "{palette.white}", "$description": "Speech bubble of the guide Mây (NpcHint)." },
      "border": { "$type": "color", "$value": "{color.outline}", "$description": "Speech bubble thin ink outline (tier 2, F114)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Speech bubble text.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.speech_bubble.bg", "level": "normal" }] } }
      }
    },
    "logo": {
      "text": {
        "$type": "color",
        "$value": "{color.brand.primary}",
        "$description": "EduWorld wordmark (LogoLabel), drawn with a white sticker outline.",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.logo.outline", "level": "large" }] } }
      },
      "outline": { "$type": "color", "$value": "{palette.white}", "$description": "Sticker outline around the wordmark (readable on any backdrop)." },
      "outline_width": { "$type": "dimension", "$value": "{size.border.8}", "$description": "Wordmark outline width." },
      "font_size": { "$type": "dimension", "$value": "{size.font.48}", "$description": "Wordmark font size (same for every grade band)." },
      "spark": { "$type": "color", "$value": "{palette.zone.gold}", "$description": "Knowledge Spark (Tia Sáng) mark beside the wordmark." },
      "spark_core": { "$type": "color", "$value": "{palette.white}", "$description": "Spark highlight." },
      "spark_outline": { "$type": "color", "$value": "{palette.ink.900}", "$description": "Spark outline." }
    },
    "backdrop": {
      "sky_top": { "$type": "color", "$value": "{palette.zone.sky-day}", "$description": "Sky backdrop gradient, top." },
      "sky_bottom": { "$type": "color", "$value": "{palette.zone.fog-warm}", "$description": "Sky backdrop gradient, horizon (warm)." },
      "sun": { "$type": "color", "$value": "{palette.amber.200}", "$description": "Sun disc." },
      "sun_glow": { "$type": "color", "$value": "{palette.zone.sun}", "$description": "Sun halo." },
      "cloud": { "$type": "color", "$value": "{palette.white}", "$description": "Soft clouds." },
      "hill_far": { "$type": "color", "$value": "{palette.zone.ground-horizon}", "$description": "Far hills." },
      "hill_near": { "$type": "color", "$value": "{palette.green.300}", "$description": "Near hills." },
      "island_grass": { "$type": "color", "$value": "{palette.green.400}", "$description": "Floating island grass." },
      "island_rock": { "$type": "color", "$value": "{palette.sand.400}", "$description": "Floating island rock (shade)." },
      "island_rock_light": { "$type": "color", "$value": "{palette.sand.200}", "$description": "Floating island rock (lit)." },
      "spark": { "$type": "color", "$value": "{palette.zone.gold}", "$description": "Knowledge Sparks floating in the sky." }
    },
    "mascot": {
      "body": { "$type": "color", "$value": "{palette.white}", "$description": "Mây (Cloudy) body." },
      "shade": { "$type": "color", "$value": "{palette.sky.100}", "$description": "Mây underside shade." },
      "outline": { "$type": "color", "$value": "{palette.ink.900}", "$description": "Mây outline." },
      "eye": { "$type": "color", "$value": "{palette.ink.900}", "$description": "Mây eyes and smile." },
      "cheek": { "$type": "color", "$value": "{palette.pink.200}", "$description": "Mây cheeks." },
      "size": { "$type": "dimension", "$value": "{size.layout.200}", "$description": "Mây illustration size." },
      "outline_width": { "$type": "dimension", "$value": "{size.border.4}", "$description": "Mây outline width." }
    },
    "progress": {
      "track": { "$type": "color", "$value": "{palette.white}", "$description": "Rounded loading bar track (Web shell, F096)." },
      "fill": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Rounded loading bar fill.", "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.progress.track", "level": "graphic" }] } } },
      "border": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Rounded loading bar outline." },
      "height": { "$type": "dimension", "$value": "{size.space.24}", "$description": "Rounded loading bar height." }
    },
    "answer_tile": {
      "bg_1": { "$type": "color", "$value": "{palette.sky.100}", "$description": "Answer tile 1 background (blue tint, F097)." },
      "accent_1": { "$type": "color", "$value": "{palette.blue.600}", "$description": "Answer tile 1 border, number badge and selected fill (blue, F097)." },
      "bg_2": { "$type": "color", "$value": "{palette.plum.50}", "$description": "Answer tile 2 background (plum tint, F099: no orange — the not-yet-right state colour)." },
      "accent_2": { "$type": "color", "$value": "{palette.plum.700}", "$description": "Answer tile 2 border, number badge and selected fill (plum, F099)." },
      "bg_3": { "$type": "color", "$value": "{palette.pink.50}", "$description": "Answer tile 3 background (pink tint, F099: no green — the right state colour)." },
      "accent_3": { "$type": "color", "$value": "{palette.pink.700}", "$description": "Answer tile 3 border, number badge and selected fill (pink, F099)." },
      "bg_4": { "$type": "color", "$value": "{palette.cyan.50}", "$description": "Answer tile 4 background (ocean blue tint, F099)." },
      "accent_4": { "$type": "color", "$value": "{palette.cyan.700}", "$description": "Answer tile 4 border, number badge and selected fill (ocean blue, F099)." },
      "bg_5": { "$type": "color", "$value": "{palette.violet.50}", "$description": "Answer tile 5 background (violet tint, F099)." },
      "accent_5": { "$type": "color", "$value": "{palette.violet.700}", "$description": "Answer tile 5 border, number badge and selected fill (violet, F099)." },
      "bg_6": { "$type": "color", "$value": "{palette.indigo.50}", "$description": "Answer tile 6 background (indigo tint, F099: no teal next to the green state)." },
      "accent_6": { "$type": "color", "$value": "{palette.indigo.700}", "$description": "Answer tile 6 border, number badge and selected fill (indigo, F099)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Answer tile label on its tint.",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.answer_tile.bg_1", "level": "normal" },
          { "token": "component.answer_tile.bg_2", "level": "normal" },
          { "token": "component.answer_tile.bg_3", "level": "normal" },
          { "token": "component.answer_tile.bg_4", "level": "normal" },
          { "token": "component.answer_tile.bg_5", "level": "normal" },
          { "token": "component.answer_tile.bg_6", "level": "normal" }
        ] } }
      },
      "text_selected": {
        "$type": "color",
        "$value": "{palette.white}",
        "$description": "Answer tile label and badge number on the selected (accent) fill; the badge also shows a tick (never colour alone).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.answer_tile.accent_1", "level": "normal" },
          { "token": "component.answer_tile.accent_2", "level": "normal" },
          { "token": "component.answer_tile.accent_3", "level": "normal" },
          { "token": "component.answer_tile.accent_4", "level": "normal" },
          { "token": "component.answer_tile.accent_5", "level": "normal" },
          { "token": "component.answer_tile.accent_6", "level": "normal" },
          { "token": "component.answer_tile.rest_accent", "level": "normal" }
        ] } }
      },
      "edge": { "$type": "dimension", "$value": "{size.border.6}", "$description": "Bottom depth edge of an answer tile (candy look)." },
      "radius": { "$type": "dimension", "$value": "{size.radius.24}", "$description": "Answer tile corner radius." },
      "badge_size": { "$type": "dimension", "$value": "{size.icon.40}", "$description": "Number badge diameter on the left of an answer tile." },
      "correct_bg": { "$type": "color", "$value": "{palette.green.50}", "$description": "Tile background after a right answer (tap-to-answer, F098); shown with a tick badge and words, never colour alone." },
      "correct_border": { "$type": "color", "$value": "{palette.green.700}", "$description": "Tile border and verdict badge after a right answer, and the right-answer tile (F098)." },
      "try_bg": { "$type": "color", "$value": "{palette.orange.50}", "$description": "Tile background after a not-yet-right answer: warm, never a punishing red (F098)." },
      "try_border": { "$type": "color", "$value": "{palette.orange.700}", "$description": "Tile border and verdict badge after a not-yet-right answer (F098)." },
      "result_border": { "$type": "dimension", "$value": "{size.border.4}", "$description": "Border width of a graded tile (right / not yet right / right answer), thicker than a normal tile (F098)." },
      "tag_correct_bg": { "$type": "color", "$value": "{palette.green.700}", "$description": "Verdict tag on a right or right-answer tile (F098)." },
      "tag_try_bg": { "$type": "color", "$value": "{palette.orange.700}", "$description": "Verdict tag on a not-yet-right tile (F098)." },
      "tag_pending_bg": { "$type": "color", "$value": "{palette.white}", "$description": "Grading tag on the tapped tile while the server grades (F098)." },
      "tag_pending_border": { "$type": "color", "$value": "{palette.blue.600}", "$description": "Border of the grading tag and the dots of the pending badge (F098)." },
      "tag_text": {
        "$type": "color",
        "$value": "{palette.white}",
        "$description": "Words of the verdict tags (F098).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.answer_tile.tag_correct_bg", "level": "normal" },
          { "token": "component.answer_tile.tag_try_bg", "level": "normal" }
        ] } }
      },
      "rest_bg": { "$type": "color", "$value": "{palette.white}", "$description": "Resting tile after grading (F099): every tile that is neither the chosen one nor the right answer — calm, readable, never greyed out as a failure." },
      "rest_border": { "$type": "color", "$value": "{palette.ink.200}", "$description": "Neutral outline and depth edge of a resting tile (F099)." },
      "rest_accent": { "$type": "color", "$value": "{palette.ink.600}", "$description": "Number badge disc of a resting tile (F099); the number stays." },
      "rest_text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Label of a resting tile (F099).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.answer_tile.rest_bg", "level": "normal" }] } }
      },
      "grow_max": { "$type": "number", "$value": "{number.ratio.150}", "$description": "Largest answer tile height as a multiple of density.<band>.answer.min_height when the board has free room, landscape window (F099)." },
      "grow_max_tall": { "$type": "number", "$value": "{number.ratio.400}", "$description": "Largest answer tile height as a multiple of density.<band>.answer.min_height, portrait window (F099)." },
      "tag_pending_text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Words of the grading tag (F098).",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.answer_tile.tag_pending_bg", "level": "normal" }
        ] } }
      }
    },
    "caption": {
      "bg": { "$type": "color", "$value": "{palette.white}", "$description": "Readable caption card of the video player (F099): light card, not a see-through strip." },
      "border": { "$type": "color", "$value": "{palette.sky.300}", "$description": "Caption card outline (F099)." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Caption words and the speaker name written before them (F099; never a colour code).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.caption.bg", "level": "normal" }] } }
      }
    },
    "media_track": {
      "track": { "$type": "color", "$value": "{palette.sky.200}", "$description": "Media progress bar groove (F099)." },
      "watched": { "$type": "color", "$value": "{palette.sky.300}", "$description": "Part already watched / heard — the student may seek inside it (F099)." },
      "played": {
        "$type": "color",
        "$value": "{color.accent.primary}",
        "$description": "Played part and thumb of the media progress bar (F099).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.media_track.track", "level": "graphic" }] } }
      },
      "chapter": {
        "$type": "color",
        "$value": "{palette.ink.700}",
        "$description": "Notch at the start of each chapter / audio segment (F099).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.media_track.track", "level": "graphic" }] } }
      },
      "marker": { "$type": "color", "$value": "{palette.amber.400}", "$description": "Disc of a question not answered yet (with a question mark, F099)." },
      "marker_done": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Disc of an answered question (with a tick, F099: shape and colour)." },
      "marker_text": {
        "$type": "color",
        "$value": "{palette.ink.900}",
        "$description": "Question mark on a pending question disc (F099).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.media_track.marker", "level": "normal" }] } }
      },
      "marker_done_text": {
        "$type": "color",
        "$value": "{palette.white}",
        "$description": "Tick on an answered question disc (F099).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.media_track.marker_done", "level": "normal" }] } }
      }
    },
    "media_stage": {
      "bg": { "$type": "color", "$value": "{palette.ink.900}", "$description": "Screen behind the video picture (F099)." }
    },
    "question_card": {
      "bg": { "$type": "color", "$value": "{palette.white}", "$description": "Question card (stem + read-aloud) background (F097)." },
      "border": { "$type": "color", "$value": "{palette.sky.300}", "$description": "Question card border." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Question stem text (StemLabel).",
        "$extensions": { "eduworld": { "contrastWith": [{ "token": "component.question_card.bg", "level": "normal" }] } }
      }
    },
    "drop_zone": {
      "bg": { "$type": "color", "$value": "{palette.white}", "$description": "Drop zone / matching target background (F097)." },
      "border": { "$type": "color", "$value": "{palette.sky.300}", "$description": "Drop zone outline." },
      "bg_hover": { "$type": "color", "$value": "{palette.sky.100}", "$description": "Drop zone background on hover / while a card is picked." }
    },
    "feedback": {
      "correct_bg": { "$type": "color", "$value": "{palette.green.50}", "$description": "Correct verdict panel background (soft, with a tick icon and words, F097)." },
      "correct_border": { "$type": "color", "$value": "{color.feedback.correct}", "$description": "Correct verdict panel border and icon disc." },
      "try_bg": { "$type": "color", "$value": "{palette.orange.50}", "$description": "Not-yet-correct verdict panel background: warm, never a punishing red (F097)." },
      "try_border": { "$type": "color", "$value": "{palette.orange.700}", "$description": "Not-yet-correct verdict panel border and icon disc." },
      "text": {
        "$type": "color",
        "$value": "{color.text.primary}",
        "$description": "Verdict words on the soft verdict panels.",
        "$extensions": { "eduworld": { "contrastWith": [
          { "token": "component.feedback.correct_bg", "level": "normal" },
          { "token": "component.feedback.try_bg", "level": "normal" }
        ] } }
      }
    },
    "progress_trail": {
      "done": { "$type": "color", "$value": "{palette.amber.400}", "$description": "Answered question: a filled star (shape, not only colour, F097)." },
      "current": { "$type": "color", "$value": "{color.accent.primary}", "$description": "Current question: a large ring." },
      "todo": { "$type": "color", "$value": "{palette.white}", "$description": "Question still to do: a small hollow dot." },
      "track": { "$type": "color", "$value": "{palette.sky.200}", "$description": "Line joining the dots." },
      "outline": { "$type": "color", "$value": "{palette.ink.900}", "$description": "Outline of stars and dots." }
    },
    "activity_board": {
      "bg": { "$type": "color", "$value": "{color.surface.panel}", "$description": "Activity player board over the sky backdrop (F097)." },
      "border": { "$type": "color", "$value": "{palette.white}", "$description": "Activity board soft white rim." },
      "inset": { "$type": "dimension", "$value": "{size.space.12}", "$description": "Gap between the window edge and the activity board (the sky shows around it)." }
    },
    "coach": {
      "size": { "$type": "dimension", "$value": "{size.layout.120}", "$description": "Coach Mây beside the activity feedback and hints (F097)." }
    },
    "focus_ring": {
      "color": { "$type": "color", "$value": "{color.focus}", "$description": "Focus ring color." },
      "width": { "$type": "dimension", "$value": "{size.border.4}", "$description": "Focus ring width." }
    }
  }
}
