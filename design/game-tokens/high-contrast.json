    "g4_5": { "outline": { "interactive": { "$value": "{size.border.3}", "$description": "Tier 1 outline (high contrast, g4_5)." }, "info": { "$value": "{size.border.3}", "$description": "Tier 2 outline (high contrast, g4_5)." } } },
    "g6_7": { "outline": { "interactive": { "$value": "{size.border.3}", "$description": "Tier 1 outline (high contrast, g6_7)." }, "info": { "$value": "{size.border.3}", "$description": "Tier 2 outline (high contrast, g6_7)." } } },
    "g8_9": { "outline": { "interactive": { "$value": "{size.border.3}", "$description": "Tier 1 outline (high contrast, g8_9)." }, "info": { "$value": "{size.border.3}", "$description": "Tier 2 outline (high contrast, g8_9)." } } }
  }
