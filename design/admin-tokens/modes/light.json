{
  "ops": {
    "mode": {
      "$type": "color",
      "$description": "Light mode values referenced by admin semantic tokens. Same paths as modes/dark.json.",
      "text": {
        "base": { "$value": "{ops.palette.black}", "$description": "Ant Design colorTextBase (light)." },
        "primary": { "$value": "{ops.palette.slate.900}", "$description": "Primary text (light)." },
        "secondary": { "$value": "{ops.palette.slate.600}", "$description": "Secondary text (light)." },
        "link": { "$value": "{ops.palette.status.info}", "$description": "Link text (light)." },
        "accent": { "$value": "{color.brand.primary}", "$description": "Selected tab text and ink bar (light)." },
        "danger": { "$value": "{ops.palette.status.error}", "$description": "Danger button text and solid danger fill (light)." },
        "on-danger": { "$value": "{ops.palette.white}", "$description": "Text on the solid danger fill (light)." },
        "warning": { "$value": "{ops.palette.amber.800}", "$description": "Warning tag text (light)." }
      },
      "bg": {
        "base": { "$value": "{ops.palette.white}", "$description": "Ant Design colorBgBase (light)." },
        "container": { "$value": "{ops.palette.white}", "$description": "Container background (light)." },
        "layout": { "$value": "{ops.palette.slate.50}", "$description": "Layout background (light)." }
      },
      "border": { "$value": "{ops.palette.neutral.300}", "$description": "Border (light)." },
      "border-subtle": { "$value": "{ops.palette.slate.200}", "$description": "Subtle border of cards, header and sidebar (light)." },
      "sider": {
        "bg": { "$value": "{ops.palette.navy.800}", "$description": "Sidebar background (light)." },
        "hover-bg": { "$value": "{ops.palette.navy.700}", "$description": "Sidebar item hover background (light)." },
        "selected-bg": { "$value": "{ops.palette.white}", "$description": "Selected sidebar item tile (light): white on deep blue." },
        "text": { "$value": "{ops.palette.navy.100}", "$description": "Sidebar item text (light)." },
        "selected-text": { "$value": "{ops.palette.navy.800}", "$description": "Selected sidebar item text (light)." }
      },
      "banner": {
        "info": { "$value": "{ops.palette.banner.info-light}", "$description": "Info banner (light)." },
        "warning": { "$value": "{ops.palette.banner.warning-light}", "$description": "Warning banner (light)." },
        "error": { "$value": "{ops.palette.banner.error-light}", "$description": "Error banner (light)." }
      }
    }
  }
}
