{
  "ops": {
    "mode": {
      "$type": "color",
      "$description": "Dark mode values referenced by admin semantic tokens. Same paths as modes/light.json.",
      "text": {
        "base": { "$value": "{ops.palette.white}", "$description": "Ant Design colorTextBase (dark)." },
        "primary": { "$value": "{ops.palette.neutral.200}", "$description": "Primary text (dark)." },
        "secondary": { "$value": "{ops.palette.neutral.500}", "$description": "Secondary text (dark)." },
        "link": { "$value": "{ops.palette.blue.300}", "$description": "Link text (dark)." },
        "accent": { "$value": "{ops.palette.blue.300}", "$description": "Selected tab text and ink bar (dark)." },
        "danger": { "$value": "{ops.palette.red.300}", "$description": "Danger button text and solid danger fill (dark)." },
        "on-danger": { "$value": "{ops.palette.neutral.900}", "$description": "Text on the solid danger fill (dark)." },
        "warning": { "$value": "{ops.palette.amber.400}", "$description": "Warning tag text (dark)." },
        "success": { "$value": "{ops.palette.green.300}", "$description": "Success tag text (dark)." }
      },
      "bg": {
        "base": { "$value": "{ops.palette.neutral.900}", "$description": "Ant Design colorBgBase (dark)." },
        "container": { "$value": "{ops.palette.neutral.900}", "$description": "Container background (dark)." },
        "layout": { "$value": "{ops.palette.black}", "$description": "Layout background (dark)." }
      },
      "border": { "$value": "{ops.palette.neutral.700}", "$description": "Border (dark)." },
      "border-subtle": { "$value": "{ops.palette.neutral.800}", "$description": "Subtle border of cards, header and sidebar (dark)." },
      "sider": {
        "bg": { "$value": "{ops.palette.navy.900}", "$description": "Sidebar background (dark)." },
        "hover-bg": { "$value": "{ops.palette.navy.850}", "$description": "Sidebar item hover background (dark)." },
        "selected-bg": { "$value": "{color.brand.primary}", "$description": "Selected sidebar item tile (dark): brand primary." },
        "text": { "$value": "{ops.palette.navy.150}", "$description": "Sidebar item text (dark)." },
        "selected-text": { "$value": "{ops.palette.white}", "$description": "Selected sidebar item text (dark)." }
      },
      "banner": {
        "info": { "$value": "{ops.palette.banner.info-dark}", "$description": "Info banner (dark)." },
        "warning": { "$value": "{ops.palette.banner.warning-dark}", "$description": "Warning banner (dark)." },
        "success": { "$value": "{ops.palette.banner.success-dark}", "$description": "Success tag background (dark)." },
        "error": { "$value": "{ops.palette.banner.error-dark}", "$description": "Error banner (dark)." }
      }
    }
  }
}
