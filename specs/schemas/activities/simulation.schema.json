{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/content/activities/simulation.schema.json",
  "title": "SimulationActivityVersion",
  "description": "activity_type = simulation. Chỉ tham số hóa template Godot đóng gói sẵn; không có trường script/code (ADR-0052). Xem docs/02-learning/SIMULATION_ENGINE.md.",
  "type": "object",
  "allOf": [{ "$ref": "activity-base.schema.json#/$defs/activityCommon" }],
  "required": ["activity_type", "content"],
  "properties": {
    "activity_type": { "const": "simulation" },
    "content": {
      "type": "object",
      "required": ["simulation_kind", "template_code", "min_template_version", "parameters", "goals"],
      "properties": {
        "simulation_kind": { "type": "string", "enum": ["science_simulation", "physics", "geometry_3d", "virtual_lab", "interactive_experiment"] },
        "template_code": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9_]+(\\.[a-z0-9_]+)+$" },
        "min_template_version": { "type": "integer", "minimum": 1 },
        "parameters": {
          "type": "object",
          "maxProperties": 50,
          "description": "Giá trị tham số; được validate thêm bằng parameter_schema của template phía server",
          "additionalProperties": {
            "anyOf": [
              { "type": "number" },
              { "type": "boolean" },
              { "type": "string", "maxLength": 128 }
            ]
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["goal_id", "description", "check"],
            "properties": {
              "goal_id": { "$ref": "activity-base.schema.json#/$defs/slug" },
              "description": { "$ref": "activity-base.schema.json#/$defs/i18nShort" },
              "check": {
                "type": "object",
                "required": ["metric", "operator", "value"],
                "properties": {
                  "metric": { "type": "string", "maxLength": 64, "pattern": "^[a-z0-9_.]+$" },
                  "operator": { "type": "string", "enum": ["eq", "lt", "lte", "gt", "gte", "abs_diff_lte"] },
                  "value": { "type": "number" },
                  "tolerance": { "type": "number", "minimum": 0 }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "required": ["step_id", "instruction"],
            "properties": {
              "step_id": { "$ref": "activity-base.schema.json#/$defs/slug" },
              "instruction": { "$ref": "activity-base.schema.json#/$defs/i18nMedium" },
              "safety_required": { "type": "boolean", "default": false }
            },
            "additionalProperties": false
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "activity-base.schema.json#/$defs/questionRef" }
        },
        "seed_policy": { "type": "string", "enum": ["fixed", "per_attempt"], "default": "per_attempt" }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "max_runs": { "type": "integer", "minimum": 1, "maximum": 50 },
        "show_measurements": { "type": "boolean", "default": true }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false,
  "$defs": {
    "render": {
      "title": "SimulationRender",
      "description": "ActivityRender.render_payload của simulation (F066-AC-10): mục tiêu chỉ có goal_id + description, không có check (research R3), câu hỏi không đáp án.",
      "type": "object",
      "additionalProperties": false,
      "required": ["simulation_kind", "template_code", "template_version", "parameters", "goals", "steps", "interaction", "seed", "runs_used", "questions"],
      "properties": {
        "simulation_kind": { "type": "string", "enum": ["science_simulation", "physics", "geometry_3d", "virtual_lab", "interactive_experiment"] },
        "template_code": { "type": "string", "maxLength": 64 },
        "template_version": { "type": "integer", "minimum": 1 },
        "parameters": {
          "type": "object",
          "maxProperties": 50,
          "additionalProperties": { "anyOf": [{ "type": "number" }, { "type": "boolean" }, { "type": "string", "maxLength": 128 }] }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["goal_id", "description"],
            "properties": {
              "goal_id": { "$ref": "activity-base.schema.json#/$defs/slug" },
              "description": { "$ref": "activity-base.schema.json#/$defs/i18nShort" }
            }
          }
        },
        "steps": {
          "type": "array",
          "maxItems": 30,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["step_id", "instruction", "safety_required"],
            "properties": {
              "step_id": { "$ref": "activity-base.schema.json#/$defs/slug" },
              "instruction": { "$ref": "activity-base.schema.json#/$defs/i18nMedium" },
              "safety_required": { "type": "boolean" }
            }
          }
        },
        "interaction": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_runs", "show_measurements"],
          "properties": {
            "max_runs": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
            "show_measurements": { "type": "boolean" }
          }
        },
        "seed": { "type": "integer", "minimum": 0 },
        "runs_used": { "type": "integer", "minimum": 0 },
        "questions": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["position"],
            "properties": { "position": { "type": "integer", "minimum": 1 } }
          }
        }
      }
    }
  }
}
