{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/content/activities/project.schema.json",
  "title": "ProjectActivityVersion",
  "description": "activity_type = project (bài nhiều bước, cá nhân hoặc nhóm). Mỗi học sinh có attempt và learning record riêng. Xem docs/02-learning/WRITTEN_RESPONSE_RUBRIC.md §8.",
  "type": "object",
  "allOf": [{ "$ref": "activity-base.schema.json#/$defs/activityCommon" }],
  "required": ["activity_type", "content"],
  "properties": {
    "activity_type": { "const": "project" },
    "content": {
      "type": "object",
      "required": ["group_mode", "milestones"],
      "properties": {
        "group_mode": { "type": "string", "enum": ["individual", "group"] },
        "group_size": {
          "type": "object",
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 2, "maximum": 6 },
            "max": { "type": "integer", "minimum": 2, "maximum": 6 }
          },
          "additionalProperties": false
        },
        "milestones": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "items": {
            "type": "object",
            "required": ["milestone_id", "title", "submission_kinds"],
            "properties": {
              "milestone_id": { "$ref": "activity-base.schema.json#/$defs/slug" },
              "title": { "$ref": "activity-base.schema.json#/$defs/i18nShort" },
              "instructions": { "$ref": "activity-base.schema.json#/$defs/i18nLong" },
              "due_offset_days": { "type": "integer", "minimum": 0, "maximum": 180 },
              "submission_kinds": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "enum": ["text", "file", "recording", "activity_ref"] }
              },
              "activity_ref": { "$ref": "activity-base.schema.json#/$defs/uuid" }
            },
            "additionalProperties": false
          }
        },
        "contribution_note_required": { "type": "boolean", "default": true },
        "individual_rubric_ref": {
          "type": "object",
          "required": ["rubric_id", "version"],
          "properties": {
            "rubric_id": { "$ref": "activity-base.schema.json#/$defs/uuid" },
            "version": { "type": "integer", "minimum": 1 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "interaction": {
      "type": "object",
      "properties": {
        "allow_late_submission": { "type": "boolean", "default": false }
      },
      "additionalProperties": false
    }
  },
  "unevaluatedProperties": false
}
