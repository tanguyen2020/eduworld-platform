{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/character-catalog.schema.json",
  "title": "CharacterCatalog v1",
  "description": "Payload của một version CharacterCatalog (nội dung platform có version, ADR-0043; F070): preset tạo nhân vật, dáng người, bảng màu da/tóc, item và emote mặc định (miễn phí cho mọi học sinh), bộ từ sinh nickname theo ngôn ngữ (CHARACTER_SYSTEM §5.0, §5.3). Seed bởi module game; biên tập trên Game Operations Console ở F078. Không hardcode trong client (R2). Mọi chuỗi có maxLength (ADR-0041).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "presets", "body_types", "skin_tones", "hair_colors", "default_item_ids", "default_emote_ids", "items", "nickname_parts"],
  "properties": {
    "schema_version": { "const": 1 },
    "presets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "description": "Số preset hiển thị theo avatar_creation_presets (CONFIG_DEFAULTS)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["preset_code", "name", "avatar_config"],
        "properties": {
          "preset_code": { "$ref": "#/$defs/code" },
          "name": { "$ref": "#/$defs/name" },
          "avatar_config": { "$ref": "https://schemas.eduworld.vn/avatar-config.schema.json" },
          "thumbnail_asset_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "body_types": { "$ref": "#/$defs/namedCodes" },
    "skin_tones": { "$ref": "#/$defs/namedCodes", "description": "Mã màu da = khóa token design/game-tokens/art3d.json avatar.skin_tone.<code> (OQ F070-2, T041); danh mục không chứa mã màu hex." },
    "hair_colors": { "$ref": "#/$defs/namedCodes", "description": "Mã màu tóc = khóa token design/game-tokens/art3d.json avatar.hair_color.<code> (OQ F070-2, T041)." },
    "default_item_ids": { "type": "array", "maxItems": 200, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
    "default_emote_ids": { "type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": { "$ref": "#/$defs/code" } },
    "items": {
      "type": "array",
      "maxItems": 206,
      "description": "Tên hiển thị vi/en và ô trang phục của mỗi item mặc định và emote mặc định — đúng một mục cho mỗi mã của default_item_ids và default_emote_ids (OQ F070-1, T040). Quyền sở hữu vẫn do server quyết.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "equip_slot", "name"],
        "properties": {
          "item_id": { "$ref": "#/$defs/code" },
          "equip_slot": { "type": "string", "enum": ["hair", "outfit", "head", "face", "back", "hand", "emote"] },
          "name": { "$ref": "#/$defs/name" }
        }
      }
    },
    "nickname_parts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi", "en"],
      "description": "Bộ từ đã duyệt; gợi ý = tính từ + danh từ + 2 chữ số, ≤ 24 ký tự (CHARACTER_SYSTEM §5.3)",
      "properties": {
        "vi": { "$ref": "#/$defs/nicknameWords" },
        "en": { "$ref": "#/$defs/nicknameWords" }
      }
    }
  },
  "$defs": {
    "code": { "type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z0-9_]+$" },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi", "en"],
      "properties": { "vi": { "type": "string", "minLength": 1, "maxLength": 64 }, "en": { "type": "string", "minLength": 1, "maxLength": 64 } }
    },
    "namedCodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "name"],
        "properties": { "code": { "$ref": "#/$defs/code" }, "name": { "$ref": "#/$defs/name" } }
      }
    },
    "nicknameWords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adjectives", "nouns"],
      "properties": {
        "adjectives": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 32 } },
        "nouns": { "type": "array", "minItems": 1, "maxItems": 500, "items": { "type": "string", "minLength": 1, "maxLength": 32 } }
      }
    }
  }
}
