{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/assessment-profile.schema.json",
  "title": "Hồ sơ mức tham khảo TT27/TT22 (learning.assessment_profiles.rules + disclaimer)",
  "description": "Ngưỡng assessment_reference_thresholds (CONFIG_DEFAULTS, ASSESSMENT_REGULATION_PROFILE §4) và lời miễn trừ hiển thị trên mọi response/file xuất (F044-AC-12). Đổi ngưỡng tạo version hồ sơ mới (F044-AC-14).",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile_code", "rules", "disclaimer"],
  "properties": {
    "profile_code": { "type": "string", "enum": ["primary_tt27", "lower_secondary_tt22"] },
    "grade_levels": { "type": "array", "minItems": 1, "maxItems": 9, "items": { "type": "integer", "minimum": 1, "maximum": 9 } },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_coverage", "min_evidence"],
      "properties": {
        "min_coverage": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.7 },
        "min_evidence": { "type": "integer", "minimum": 1, "maximum": 20, "default": 3 },
        "excellent_proficient_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.8 },
        "excellent_mastered_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.4 },
        "completed_developing_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 },
        "pass_developing_ratio": { "type": "number", "minimum": 0, "maximum": 1, "default": 0.6 }
      }
    },
    "disclaimer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi"],
      "properties": {
        "vi": { "type": "string", "minLength": 1, "maxLength": 500 },
        "en": { "type": "string", "maxLength": 500 }
      }
    }
  }
}
