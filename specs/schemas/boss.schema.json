{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eduworld:schema:boss:1",
  "title": "BossVersion",
  "description": "Boss nhiều phase (game-service, PvE, server-authoritative). Yêu cầu mỗi phase tham chiếu hoạt động học tập qua activity_ref (ADR-0048). Xem docs/01-game-design/CHALLENGE_BOSS_SYSTEM.md §3.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "boss_id",
    "boss_version_id",
    "code",
    "version",
    "status",
    "owner_scope",
    "name",
    "area_id",
    "grade_levels",
    "subject_id",
    "mode",
    "phases",
    "total_time_limit_seconds",
    "defeat_rewards"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "boss_id": {
      "$ref": "#/$defs/uuid"
    },
    "boss_version_id": {
      "$ref": "#/$defs/uuid"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived",
        "rejected"
      ]
    },
    "owner_scope": {
      "const": "platform"
    },
    "tenant_id": {
      "type": "null"
    },
    "name": {
      "$ref": "#/$defs/localized_text"
    },
    "description": {
      "$ref": "#/$defs/localized_text"
    },
    "area_id": {
      "type": "string",
      "maxLength": 64
    },
    "visual_ref": {
      "type": "string",
      "maxLength": 512,
      "description": "Scene/asset của boss trong gói level (ADR-0044)"
    },
    "grade_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9
      }
    },
    "subject_id": {
      "$ref": "#/$defs/uuid"
    },
    "objective_ids": {
      "type": "array",
      "maxItems": 30,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "mode": {
      "enum": [
        "solo",
        "party_optional",
        "party_required"
      ]
    },
    "party_size": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min",
        "max"
      ],
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        }
      }
    },
    "total_time_limit_seconds": {
      "type": "integer",
      "minimum": 60,
      "maximum": 7200
    },
    "max_phase_retries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10,
      "default": 3
    },
    "reconnect_grace_seconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600,
      "default": 120
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/phase"
      }
    },
    "defeat_rewards": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/reward"
      }
    },
    "first_defeat_rewards": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/reward"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "enum": [
              "party_optional",
              "party_required"
            ]
          }
        }
      },
      "then": {
        "required": [
          "party_size"
        ],
        "properties": {
          "party_size": true
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "localized_text": {
      "type": "object",
      "description": "Văn bản hiển thị song ngữ bắt buộc đủ vi và en (ADR-0056 mục 2).",
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "additionalProperties": false
    },
    "activity_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activity_type",
        "activity_id"
      ],
      "properties": {
        "activity_type": {
          "type": "string",
          "maxLength": 64
        },
        "activity_id": {
          "$ref": "#/$defs/uuid"
        },
        "activity_version": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requirement_id",
        "kind"
      ],
      "properties": {
        "requirement_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]{1,32}$"
        },
        "kind": {
          "enum": [
            "activity",
            "minigame",
            "interaction",
            "group_puzzle"
          ]
        },
        "activity_ref": {
          "$ref": "#/$defs/activity_ref"
        },
        "interactable_id": {
          "type": "string",
          "maxLength": 64
        },
        "per_grade": {
          "type": "array",
          "description": "Nội dung khác theo khối (cùng boss, khác bộ hoạt động)",
          "maxItems": 9,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "grade_level",
              "activity_ref"
            ],
            "properties": {
              "grade_level": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9
              },
              "activity_ref": {
                "$ref": "#/$defs/activity_ref"
              }
            }
          }
        },
        "pass_rule": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "min_correct_ratio": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "min_items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "activity",
                  "minigame",
                  "group_puzzle"
                ]
              }
            }
          },
          "then": {
            "anyOf": [
              {
                "required": [
                  "activity_ref"
                ],
                "properties": {
                  "activity_ref": true
                }
              },
              {
                "required": [
                  "per_grade"
                ],
                "properties": {
                  "per_grade": true
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "interaction"
              }
            }
          },
          "then": {
            "required": [
              "interactable_id"
            ],
            "properties": {
              "interactable_id": true
            }
          }
        }
      ]
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "phase_id",
        "order",
        "energy_share",
        "requirements",
        "completion_rule",
        "time_limit_seconds"
      ],
      "properties": {
        "phase_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]{1,32}$"
        },
        "order": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "title": {
          "$ref": "#/$defs/localized_text"
        },
        "energy_share": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "requirements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/requirement"
          }
        },
        "completion_rule": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "enum": [
                "all",
                "any_n",
                "collective_count"
              ]
            },
            "n": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20
            },
            "collective_target": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            },
            "min_contribution": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "any_n"
                  }
                }
              },
              "then": {
                "required": [
                  "n"
                ],
                "properties": {
                  "n": true
                }
              }
            },
            {
              "if": {
                "properties": {
                  "type": {
                    "const": "collective_count"
                  }
                }
              },
              "then": {
                "required": [
                  "collective_target",
                  "min_contribution"
                ],
                "properties": {
                  "collective_target": true,
                  "min_contribution": true
                }
              }
            }
          ]
        },
        "time_limit_seconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "on_fail": {
          "enum": [
            "retry_phase",
            "end_encounter"
          ],
          "default": "retry_phase"
        },
        "presentation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "intro_line": {
              "$ref": "#/$defs/localized_text"
            },
            "wrong_answer_reaction": {
              "type": "string",
              "maxLength": 64,
              "description": "Mã hoạt ảnh vui khi trả lời sai (không phạt, không hiển thị ai sai)"
            },
            "phase_clear_animation": {
              "type": "string",
              "maxLength": 64
            }
          }
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "xp",
            "currency",
            "item",
            "badge",
            "title",
            "collection_item"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "currency_code": {
          "type": "string",
          "maxLength": 64
        },
        "item_id": {
          "type": "string",
          "maxLength": 64
        },
        "badge_id": {
          "type": "string",
          "maxLength": 64
        },
        "title_code": {
          "type": "string",
          "maxLength": 64
        },
        "collection_item_id": {
          "type": "string",
          "maxLength": 64
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "xp",
                  "currency"
                ]
              }
            }
          },
          "then": {
            "required": [
              "amount"
            ],
            "properties": {
              "amount": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "currency"
              }
            }
          },
          "then": {
            "required": [
              "currency_code"
            ],
            "properties": {
              "currency_code": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "item"
              }
            }
          },
          "then": {
            "required": [
              "item_id"
            ],
            "properties": {
              "item_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "badge"
              }
            }
          },
          "then": {
            "required": [
              "badge_id"
            ],
            "properties": {
              "badge_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "title"
              }
            }
          },
          "then": {
            "required": [
              "title_code"
            ],
            "properties": {
              "title_code": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "collection_item"
              }
            }
          },
          "then": {
            "required": [
              "collection_item_id"
            ],
            "properties": {
              "collection_item_id": true
            }
          }
        }
      ]
    }
  }
}
