{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eduworld:schema:collection:1",
  "title": "CollectionVersion",
  "description": "Bộ sưu tập (module game, F075): pet, knowledge card, cosmetic, badge, exploration, event. Mỗi món có nguồn nhận xác định và công khai (source_hint song ngữ); knowledge card gắn một LO (objective_id), cấp khi mastery đạt proficient và không bị thu hồi. Phần thưởng hoàn thành cấp đúng một lần. Xem docs/01-game-design/INVENTORY_ECONOMY.md §6.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "collection_id",
    "code",
    "version",
    "status",
    "owner_scope",
    "collection_type",
    "visibility",
    "title",
    "items"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "collection_id": {
      "$ref": "#/$defs/uuid"
    },
    "collection_version_id": {
      "$ref": "#/$defs/uuid"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived",
        "rejected"
      ]
    },
    "owner_scope": {
      "const": "platform"
    },
    "tenant_id": {
      "type": "null"
    },
    "collection_type": {
      "enum": [
        "pet",
        "knowledge_card",
        "cosmetic",
        "badge",
        "exploration",
        "event"
      ]
    },
    "visibility": {
      "enum": [
        "always",
        "hidden_until_first"
      ],
      "description": "hidden_until_first: học sinh chỉ thấy bộ sưu tập khi đã có món đầu tiên"
    },
    "title": {
      "$ref": "#/$defs/localized_name"
    },
    "description": {
      "$ref": "#/$defs/localized_text"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "source_hint"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "^[a-z0-9_]+$"
          },
          "source_hint": {
            "$ref": "#/$defs/localized_hint"
          },
          "objective_id": {
            "$ref": "#/$defs/uuid",
            "description": "LO của knowledge card (bắt buộc với collection_type knowledge_card)"
          }
        }
      }
    },
    "completion_rewards": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "$ref": "#/$defs/reward"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "collection_type": {
            "const": "knowledge_card"
          }
        }
      },
      "then": {
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "objective_id"
              ],
              "properties": {
                "objective_id": true
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "localized_name": {
      "type": "object",
      "required": [
        "vi",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255
        }
      }
    },
    "localized_hint": {
      "type": "object",
      "description": "\"Cách nhận\" công khai song ngữ (≤ 500 ký tự)",
      "required": [
        "vi",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "localized_text": {
      "type": "object",
      "required": [
        "vi",
        "en"
      ],
      "additionalProperties": false,
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      }
    },
    "reward": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "description": "Phần thưởng hoàn thành (không có xp: XP chỉ đến từ reward rule, F075 Clarifications)",
      "properties": {
        "type": {
          "enum": [
            "currency",
            "item",
            "badge",
            "title"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        },
        "currency_code": {
          "const": "xu"
        },
        "item_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "badge_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        },
        "title_code": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z0-9_]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "currency"
              }
            }
          },
          "then": {
            "required": [
              "amount",
              "currency_code"
            ],
            "properties": {
              "amount": true,
              "currency_code": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "item"
              }
            }
          },
          "then": {
            "required": [
              "item_id"
            ],
            "properties": {
              "item_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "badge"
              }
            }
          },
          "then": {
            "required": [
              "badge_id"
            ],
            "properties": {
              "badge_id": true
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "title"
              }
            }
          },
          "then": {
            "required": [
              "title_code"
            ],
            "properties": {
              "title_code": true
            }
          }
        }
      ]
    }
  }
}
