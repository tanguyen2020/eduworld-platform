{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/content/question-widgets/balance_scale.v1.schema.json",
  "title": "Widget balance_scale@1.0 (F023, QUESTION_BANK §3.11)",
  "description": "config của render_payload và answer_key.params của validator balance_scale.equal. Server phát lại action_log (place/remove {w}) từ config: mỗi quả cân có sẵn dùng tối đa một lần, tối đa max_moves thao tác; đúng khi tổng đĩa phải bằng target (mặc định tổng đĩa trái).",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "required": [
        "left_weights",
        "available_weights",
        "max_moves"
      ],
      "additionalProperties": false,
      "properties": {
        "left_weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "available_weights": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000
          }
        },
        "max_moves": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        }
      }
    },
    "params": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        }
      }
    }
  },
  "examples": [
    {
      "config": {
        "left_weights": [
          5,
          3
        ],
        "available_weights": [
          1,
          2,
          4,
          8
        ],
        "max_moves": 6
      },
      "params": {
        "target": 8
      }
    }
  ]
}
