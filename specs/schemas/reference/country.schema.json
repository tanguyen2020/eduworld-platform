{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/reference/country.schema.json",
  "title": "Danh mục quốc gia (ADR-0060)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "schema_version", "source", "items"],
  "properties": {
    "dataset": { "type": "string", "const": "countries" },
    "schema_version": { "type": "integer", "const": 1 },
    "source": { "type": "string", "maxLength": 255 },
    "verification": { "type": "string", "maxLength": 500 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": { "$ref": "#/$defs/country" }
    }
  },
  "$defs": {
    "localizedName": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vi", "en"],
      "properties": {
        "vi": { "type": "string", "minLength": 1, "maxLength": 128 },
        "en": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "country": {
      "type": "object",
      "additionalProperties": false,
      "required": ["country_code", "name", "default_locale", "status"],
      "properties": {
        "country_code": { "type": "string", "pattern": "^[A-Z]{2}$", "maxLength": 2, "description": "ISO 3166-1 alpha-2" },
        "name": { "$ref": "#/$defs/localizedName" },
        "default_locale": { "type": "string", "enum": ["vi-VN", "en-US"] },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      }
    }
  }
}
