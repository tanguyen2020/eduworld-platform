{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/reference/province-succession.schema.json",
  "title": "Kế thừa đơn vị hành chính cấp tỉnh (cũ → mới) (ADR-0060)",
  "type": "object",
  "additionalProperties": false,
  "required": ["dataset", "schema_version", "country_code", "source", "items"],
  "properties": {
    "dataset": { "type": "string", "const": "province_successions" },
    "schema_version": { "type": "integer", "const": 1 },
    "country_code": { "type": "string", "pattern": "^[A-Z]{2}$", "maxLength": 2 },
    "source": { "type": "string", "maxLength": 255 },
    "verification": { "type": "string", "maxLength": 500 },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["old_code", "new_code", "effective_date", "kind"],
        "properties": {
          "old_code": { "type": "string", "pattern": "^[a-z]{2}(\\.old)?\\.[a-z0-9-]+$", "maxLength": 64 },
          "new_code": { "type": "string", "pattern": "^[a-z]{2}(\\.old)?\\.[a-z0-9-]+$", "maxLength": 64 },
          "effective_date": { "type": "string", "format": "date" },
          "kind": { "type": "string", "enum": ["merged", "unchanged", "renamed", "split"] }
        }
      }
    }
  }
}
