{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:eduworld:schema:minigame-config-version:1",
  "title": "MiniGameConfigVersion",
  "description": "Cấu hình một phiên bản mini-game. Mini-game không chứa câu hỏi riêng; câu hỏi lấy từ Question Bank qua question_source. Xem docs/08-game-client/MINIGAME_ENGINE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "minigame_config_id",
    "minigame_config_version_id",
    "code",
    "version",
    "status",
    "owner_scope",
    "minigame_type",
    "name",
    "grade_levels",
    "subject_id",
    "question_source",
    "difficulty",
    "question_count",
    "scoring",
    "result_calculation",
    "feedback_policy",
    "completion_rule"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "minigame_config_id": {
      "$ref": "#/$defs/uuid"
    },
    "minigame_config_version_id": {
      "$ref": "#/$defs/uuid"
    },
    "code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "approved",
        "published",
        "archived",
        "rejected"
      ]
    },
    "owner_scope": {
      "const": "platform",
      "description": "Cấu hình game chỉ thuộc platform, sửa qua /api/v1/game-admin (ADR-0027); tenant dùng khi được gán (ADR-0029)"
    },
    "tenant_id": {
      "type": "null",
      "description": "Luôn null: dữ liệu platform"
    },
    "minigame_type": {
      "enum": [
        "multiple_choice",
        "true_false",
        "fill_in_blank",
        "drag_and_drop",
        "matching",
        "ordering",
        "calculation",
        "puzzle",
        "word_game",
        "science_simulation",
        "timed_challenge"
      ]
    },
    "name": {
      "$ref": "#/$defs/localized_text"
    },
    "instructions": {
      "$ref": "#/$defs/localized_text"
    },
    "grade_levels": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 9
      }
    },
    "subject_id": {
      "$ref": "#/$defs/uuid"
    },
    "objective_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/uuid"
      }
    },
    "question_source": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "question_set_id"
          ],
          "properties": {
            "kind": {
              "const": "question_set"
            },
            "question_set_id": {
              "$ref": "#/$defs/uuid"
            },
            "version": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind",
            "rule"
          ],
          "properties": {
            "kind": {
              "const": "selection_rule"
            },
            "rule": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "question_types"
              ],
              "properties": {
                "grade_levels": {
                  "type": "array",
                  "items": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9
                  }
                },
                "subject_id": {
                  "$ref": "#/$defs/uuid"
                },
                "topic_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "objective_ids": {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/uuid"
                  }
                },
                "difficulty_min": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "difficulty_max": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "question_types": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "enum": [
                      "single_choice",
                      "multiple_choice",
                      "true_false",
                      "fill_in_blank",
                      "short_answer",
                      "numeric_answer",
                      "matching",
                      "ordering",
                      "drag_and_drop",
                      "image_based",
                      "interactive"
                    ]
                  }
                },
                "exclude_recently_seen_days": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 60,
                  "default": 7
                }
              }
            }
          }
        }
      ]
    },
    "difficulty": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 5
        },
        {
          "const": "adaptive"
        }
      ]
    },
    "time_limit_seconds": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 10,
          "maximum": 3600
        },
        {
          "type": "null"
        }
      ]
    },
    "per_item_time_seconds": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 3,
          "maximum": 600
        },
        {
          "type": "null"
        }
      ]
    },
    "question_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "scoring": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "points_per_correct"
      ],
      "properties": {
        "points_per_correct": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "wrong_penalty": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 0
        },
        "time_bonus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "max_bonus": {
              "type": "integer",
              "minimum": 0
            },
            "full_bonus_within_ms": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "streak_bonus": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "every_n_correct": {
              "type": "integer",
              "minimum": 2
            },
            "bonus": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "result_calculation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "learning_score",
        "game_score"
      ],
      "properties": {
        "learning_score": {
          "enum": [
            "sum_question_scores",
            "correct_ratio"
          ]
        },
        "game_score": {
          "enum": [
            "points_plus_bonus",
            "points_only"
          ]
        }
      }
    },
    "feedback_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "immediate",
            "end_of_round",
            "end_of_game",
            "none"
          ]
        },
        "show_explanation": {
          "type": "boolean",
          "default": true
        },
        "show_correct_answer": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "completion_rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "complete_all",
            "min_correct_ratio",
            "min_learning_score"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "min_correct_ratio",
                  "min_learning_score"
                ]
              }
            }
          },
          "then": {
            "required": [
              "threshold"
            ],
            "properties": {
              "threshold": true
            }
          }
        }
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_plays_per_day": {
          "type": "integer",
          "minimum": 1
        },
        "retry_policy": {
          "enum": [
            "new_questions",
            "same_questions"
          ],
          "default": "new_questions"
        },
        "resumable": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "reward_rule_id": {
      "$ref": "#/$defs/uuid"
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "scene_variant": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z_]+\\.[a-z0-9_]+$"
        },
        "theme": {
          "type": "string",
          "maxLength": 40
        },
        "background_music_id": {
          "type": "string",
          "maxLength": 64
        },
        "mascot_npc_id": {
          "type": "string",
          "maxLength": 64
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "minigame_type": {
            "const": "timed_challenge"
          }
        }
      },
      "then": {
        "required": [
          "time_limit_seconds"
        ],
        "properties": {
          "time_limit_seconds": {
            "type": "integer"
          }
        }
      }
    }
  ],
  "$defs": {
    "uuid": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "localized_text": {
      "type": "object",
      "description": "Văn bản hiển thị song ngữ bắt buộc đủ vi và en (ADR-0056 mục 2).",
      "required": [
        "vi",
        "en"
      ],
      "properties": {
        "vi": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "en": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false
    }
  }
}
