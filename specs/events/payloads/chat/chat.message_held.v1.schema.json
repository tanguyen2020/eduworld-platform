{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/chat/chat.message_held.v1.schema.json",
  "title": "Payload chat.message_held v1 (module chat, owner F116)",
  "description": "Tin hold_for_review/block_and_alert đã được chat-persister lưu với moderation_state = held (không phát cho người khác; F116-AC-06, EVENT_DESIGN §4.9). KHÔNG chứa nội dung tin. Consumer: MOD (F121 tạo case).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "tenant_id",
    "message_id",
    "channel_id",
    "sender_id",
    "decision",
    "reasons",
    "created_at"
  ],
  "properties": {
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "message_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel_id": {
      "type": "string",
      "format": "uuid"
    },
    "channel_type": {
      "enum": [
        "world",
        "area",
        "match",
        "party",
        "team",
        "class",
        "study_group",
        "direct"
      ]
    },
    "sender_id": {
      "type": "string",
      "format": "uuid"
    },
    "decision": {
      "enum": [
        "hold_for_review",
        "block_and_alert"
      ]
    },
    "reasons": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "maxLength": 64
      },
      "description": "category_code của danh mục, pii, grooming_scam, bullying"
    },
    "catalog_version": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "message_id": "0193a6b2-0000-7000-8000-000000000010",
      "channel_id": "0193a1aa-0000-7000-8000-000000000020",
      "channel_type": "party",
      "sender_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002",
      "decision": "hold_for_review",
      "reasons": [
        "sexual"
      ],
      "catalog_version": 4,
      "created_at": "2026-11-21T08:30:12.345Z"
    }
  ]
}
