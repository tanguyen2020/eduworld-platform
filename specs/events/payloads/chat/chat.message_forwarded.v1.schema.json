{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/chat/chat.message_forwarded.v1.schema.json",
  "title": "Payload chat.message_forwarded v1 (module chat, owner F118)",
  "description": "Một bản chuyển tiếp đã được chat-persister ghi (tin mới ở channel đích, cùng tenant, đã qua pipeline của channel đích — F118-AC-09). KHÔNG chứa nội dung. Consumer: AUD, MOD (lần theo phát tán).",
  "type": "object",
  "additionalProperties": false,
  "required": ["tenant_id", "message_id", "channel_id", "channel_type", "sender_id", "source_message_id", "source_channel_type", "created_at"],
