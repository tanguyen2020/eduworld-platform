    "channel_id": { "type": "string", "format": "uuid" },
    "channel_type": { "enum": ["world", "area", "match", "party", "team", "direct"] },
    "sender_id": { "type": "string", "format": "uuid", "description": "Học sinh chuyển tiếp" },
    "source_message_id": { "type": "string", "format": "uuid" },
    "source_channel_type": { "enum": ["world", "area", "match", "party", "team", "direct"] },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    { "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "message_id": "0193a6b2-0000-7000-8000-000000000040", "channel_id": "0193a1aa-0000-7000-8000-000000000021", "channel_type": "match", "sender_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002", "source_message_id": "0193a6b2-0000-7000-8000-000000000010", "source_channel_type": "party", "created_at": "2026-11-22T08:30:12.345Z" }
  ]
}
