{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/chat/club.created.v1.schema.json",
  "title": "Payload club.created v1 (module chat, owner F120)",
  "description": "Club được tạo (createClub, F120-AC-17): học sinh theo student_club_creation (pending_approval/active) hoặc nhân sự trường. Chỉ id, không tên/mô tả. Consumer: NTF, AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "club_id",
    "tenant_id",
    "club_type",
    "owner_id",
    "status",
    "created_by_kind",
    "occurred_at"
  ],
  "properties": {
    "club_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "club_type": {
      "type": "string",
      "enum": [
        "school_club",
        "subject_club",
        "competition_team",
        "interest_group"
      ]
    },
    "owner_id": {
      "type": "string",
      "format": "uuid"
    },
    "school_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending_approval",
        "active"
      ]
    },
    "created_by_kind": {
      "type": "string",
      "enum": [
        "student",
        "staff"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "club_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000c1",
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "club_type": "interest_group",
      "owner_id": "0193a5f4-6c1e-7b2a-9d1f-000000000101",
      "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002",
      "status": "pending_approval",
      "created_by_kind": "student",
      "occurred_at": "2026-11-23T08:30:12.345Z"
    }
  ]
}
