    "channel_type": { "enum": ["world", "area", "match", "party", "team", "direct"] },
    "actor_id": { "type": "string", "format": "uuid", "description": "Học sinh thực hiện thao tác (người gửi khi sửa/thu hồi, người ghim)" },
    "occurred_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    { "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "message_id": "0193a6b2-0000-7000-8000-000000000010", "channel_id": "0193a1aa-0000-7000-8000-000000000020", "channel_type": "party", "actor_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002", "occurred_at": "2026-11-22T08:30:12.345Z" }
  ]
