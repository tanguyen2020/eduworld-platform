{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/chat/chat.message_pinned.v1.schema.json",
  "title": "Payload chat.message_pinned v1 (module chat, owner F118)",
