{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/study_group.created.v1.schema.json",
  "title": "Payload study_group.created v1 (module learning, ADR-0084)",
  "description": "School Admin/Academic Manager tạo nhóm học tập LMS (lms.study_groups). Phát qua outbox cùng transaction. Consumer: module chat (từ M5, tạo channel study_group và bản chiếu thành viên cho quyền vào channel), AUD. Không chứa tên/thông tin cá nhân học sinh, chỉ ID.",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_group_id", "school_id", "class_id", "grade_level", "name", "member_ids", "version", "created_by"],
  "properties": {
    "study_group_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "class_id": { "type": ["string", "null"], "format": "uuid", "description": "null = nhóm theo khối" },
    "grade_level": { "type": "integer", "minimum": 1, "maximum": 9 },
    "name": { "type": "string", "minLength": 1, "maxLength": 64 },
    "member_ids": { "type": "array", "minItems": 1, "maxItems": 100, "uniqueItems": true, "items": { "type": "string", "format": "uuid" }, "description": "student_id của thành viên" },
    "version": { "type": "integer", "minimum": 1, "description": "Version aggregate — consumer chỉ áp bản mới hơn (source_version)" },
    "created_by": { "type": "string", "format": "uuid" }
  }
}
