{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/content.version_archived.v1.schema.json",
  "title": "Payload content.version_archived v1 (module learning, owner F026)",
  "description": "Một version published không phải con trỏ hiện hành chuyển archived (ẩn khỏi lựa chọn mới, lịch sử giữ nguyên). Consumer: cache, LMS.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_type",
    "item_id",
    "version_id",
    "version",
    "owner_scope",
    "tenant_id",
    "archived_by"
  ],
  "properties": {
    "item_type": {
      "$ref": "https://schemas.eduworld.vn/common/enums.schema.json#/$defs/LearningContentType"
    },
    "item_id": {
      "type": "string",
      "format": "uuid"
    },
    "version_id": {
      "type": "string",
      "format": "uuid"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "owner_scope": {
      "type": "string",
      "enum": [
        "platform",
        "tenant"
      ]
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "archived_by": {
      "type": "string",
      "format": "uuid"
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "examples": [
    {
      "item_type": "question",
      "item_id": "0193a5f4-6c1e-7b2a-9d1f-000000000601",
      "version_id": "0193a5f4-6c1e-7b2a-9d1f-000000000602",
      "version": 1,
      "owner_scope": "tenant",
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "archived_by": "0193a5f4-6c1e-7b2a-9d1f-000000000605"
    }
  ]
}
