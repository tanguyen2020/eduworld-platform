{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/exam.opened.v1.schema.json",
  "title": "Payload exam.opened v1 (module learning, owner F042)",
  "description": "Cửa sổ thi của ExamSession mở (job exam-window hoặc tạo khi window_start ≤ now; EXAM_ENGINE §5). Envelope subject = {type: exam_session, id}. Chỉ ID (R14). Consumer: lịch LMS (F040), thông báo, realtime.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exam_session_id",
    "school_id",
    "exam_type",
    "is_official",
    "window_start",
    "window_end",
    "status"
  ],
  "properties": {
    "exam_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "school_id": {
      "type": "string",
      "format": "uuid"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "practice_test",
        "mock",
        "chapter",
        "semester",
        "subject",
        "custom"
      ]
    },
    "is_official": {
      "type": "boolean"
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "open",
        "closed",
        "results_released",
        "cancelled"
      ]
    }
  },
  "examples": [
    {
      "exam_session_id": "0193a1f0-0000-7000-8000-000000000401",
      "school_id": "0193a1f0-0000-7000-8000-000000000402",
      "exam_type": "chapter",
      "is_official": true,
      "assignment_id": null,
      "window_start": "2026-11-21T01:00:00Z",
      "window_end": "2026-11-21T02:00:00Z",
      "status": "open"
    }
  ]
}
