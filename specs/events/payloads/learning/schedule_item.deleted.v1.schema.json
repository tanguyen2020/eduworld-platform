{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/schedule_item.deleted.v1.schema.json",
  "title": "Payload schedule_item.deleted v1 (module learning, owner F040)",
  "description": "Một mục lịch LMS bị soft-delete (ADR-0028, mẫu `<entity>.deleted` của EVENT_DESIGN §4.1). Envelope subject = {type: schedule_item, id: schedule_item_id}. Chỉ ID, không PII (R14). Consumer: RT (lịch trong game), cache.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schedule_item_id", "course_id", "school_id", "tenant_id", "deleted_by"],
  "properties": {
    "schedule_item_id": { "type": "string", "format": "uuid" },
    "course_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "deleted_by": { "type": "string", "format": "uuid" },
    "reason": { "type": "string", "maxLength": 64 }
  },
  "examples": [
    {
      "schedule_item_id": "0193a1f0-0000-7000-8000-000000000301",
      "course_id": "0193a1f0-0000-7000-8000-000000000302",
      "school_id": "0193a1f0-0000-7000-8000-000000000303",
      "tenant_id": "0193a1f0-0000-7000-8000-000000000304",
      "deleted_by": "0193a1f0-0000-7000-8000-000000000305",
      "reason": "user_request"
    }
  ]
}
