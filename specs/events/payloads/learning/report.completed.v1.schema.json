{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/report.completed.v1.schema.json",
  "title": "Payload report.completed v1 (module learning, owner F044)",
  "description": "Job xuất báo cáo kết thúc (DASHBOARD_DATA §10): thành công hoặc thất bại. Consumer: thông báo trong portal cho người tạo. Không chứa link tải, tên hay dữ liệu học sinh.",
  "type": "object",
  "additionalProperties": false,
  "required": ["report_id", "scope_level", "report_type", "format", "status", "requested_by"],
  "properties": {
    "report_id": { "type": "string", "format": "uuid" },
    "scope_level": { "type": "string", "enum": ["lms", "tenant", "platform"] },
    "report_type": {
      "type": "string",
      "enum": ["assignment_results", "course_results", "regulation_reference", "skill_map", "school_monthly", "learning_summary", "class_progress", "game_summary", "efficacy_dataset"]
    },
    "format": { "type": "string", "enum": ["csv", "xlsx", "pdf"] },
    "status": { "type": "string", "enum": ["succeeded", "failed"] },
    "row_count": { "type": ["integer", "null"], "minimum": 0 },
    "requested_by": { "type": "string", "format": "uuid" }
  }
}
