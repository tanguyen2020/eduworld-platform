{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/exam.started.v1.schema.json",
  "title": "Payload exam.started v1 (module learning, owner F042)",
  "description": "Học sinh bắt đầu attempt đề (startExamAttempt, F042-AC-09): deadline_at theo đồng hồ server. Envelope subject = {type: attempt, id}. Không chứa câu hỏi/đáp án (R6).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "attempt_id",
    "exam_session_id",
    "school_id",
    "student_id",
    "exam_paper_id",
    "exam_type",
    "is_official",
    "started_at",
    "deadline_at"
  ],
  "properties": {
    "attempt_id": {
      "type": "string",
      "format": "uuid"
    },
    "exam_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "school_id": {
      "type": "string",
      "format": "uuid"
    },
    "student_id": {
      "type": "string",
      "format": "uuid"
    },
    "exam_paper_id": {
      "type": "string",
      "format": "uuid"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "practice_test",
        "mock",
        "chapter",
        "semester",
        "subject",
        "custom"
      ]
    },
    "is_official": {
      "type": "boolean"
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "deadline_at": {
      "type": "string",
      "format": "date-time"
    },
    "attempt_no": {
      "type": "integer",
      "minimum": 1
    }
  },
  "examples": [
    {
      "attempt_id": "0193a1f0-0000-7000-8000-000000000410",
      "exam_session_id": "0193a1f0-0000-7000-8000-000000000401",
      "school_id": "0193a1f0-0000-7000-8000-000000000402",
      "student_id": "0193a1f0-0000-7000-8000-000000000411",
      "exam_paper_id": "0193a1f0-0000-7000-8000-000000000412",
      "exam_type": "chapter",
      "is_official": true,
      "assignment_id": null,
      "started_at": "2026-11-21T01:05:00Z",
      "deadline_at": "2026-11-21T01:20:00Z",
      "attempt_no": 1
    }
  ]
}
