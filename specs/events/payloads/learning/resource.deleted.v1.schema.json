{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/resource.deleted.v1.schema.json",
  "title": "Payload <resource_type>.deleted v1 (module learning, owner F020, ADR-0028)",
  "description": "Một item nội dung học tập bị soft-delete (vào Thùng rác). Event type là `<resource_type>.deleted` (vd. `question.deleted`, `curriculum.deleted`); mọi loại dùng chung schema này. Envelope tenant_id = tenant sở hữu, null với nội dung platform. Consumer: AUD, vô hiệu cache nội dung.",
  "type": "object",
  "additionalProperties": false,
  "required": ["resource_type", "resource_id", "tenant_id", "deleted_by"],
  "properties": {
    "resource_type": { "type": "string", "enum": ["curriculum", "lesson", "learning_material", "question", "question_set", "assessment_blueprint", "media", "assignment"] },
    "resource_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": ["string", "null"], "format": "uuid" },
    "deleted_by": { "type": ["string", "null"], "format": "uuid" },
    "reason": { "type": "string", "maxLength": 1000 }
  },
  "examples": [
    { "resource_type": "question", "resource_id": "0193a5f4-6c1e-7b2a-9d1f-000000000101", "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "deleted_by": "0193a5f4-6c1e-7b2a-9d1f-000000000201", "reason": "duplicate" }
  ]
}
