{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/learning.recommendation_generated.v1.schema.json",
  "title": "Payload learning.recommendation_generated v1 (module learning, owner F032)",
  "description": "Danh sách gợi ý ôn tập active của một học sinh thay đổi sau lần tính lại của rule engine (LEARNING_ANALYTICS §6, FR-PRG-004, FR-PRG-008). Envelope subject = {type: student, id: student_id}. Chỉ ID, mã rule và tham chiếu nội dung — không lý do dạng văn bản, không PII (R14). Consumer: RT (đẩy NPC Mây), LMS.",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "recommendation_ids", "rule_codes", "objective_ids", "content_refs", "generated_at"],
  "properties": {
    "student_id": { "type": "string", "format": "uuid" },
    "recommendation_ids": {
      "type": "array",
      "maxItems": 20,
      "description": "Gợi ý active sau lần tính lại, theo thứ tự ưu tiên",
      "items": { "type": "string", "format": "uuid" }
    },
    "rule_codes": {
      "type": "array",
      "maxItems": 20,
      "items": { "type": "string", "enum": ["R1", "R2", "R3", "R4", "R5", "R6", "R7", "R8", "R9"] }
    },
    "objective_ids": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string", "format": "uuid" }
    },
    "content_refs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "target_type", "target_id"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["retry_wrong", "lesson", "activity", "objective_review", "assignment", "prerequisite_review", "diagnostic", "interleave_practice", "quest"]
          },
          "target_type": { "type": "string", "enum": ["activity", "lesson", "question_set", "assignment", "selection", "quest"] },
          "target_id": { "type": "string", "format": "uuid" }
        }
      }
    },
    "generated_at": { "type": "string", "format": "date-time" }
  },
  "examples": [
    {
      "student_id": "0193a1f0-0000-7000-8000-000000000001",
      "recommendation_ids": ["0193a1f0-0000-7000-8000-000000000101"],
      "rule_codes": ["R2"],
      "objective_ids": ["0193a1f0-0000-7000-8000-000000000201"],
      "content_refs": [{ "kind": "objective_review", "target_type": "selection", "target_id": "0193a1f0-0000-7000-8000-000000000201" }],
      "generated_at": "2026-11-20T08:00:00Z"
    }
  ]
}
