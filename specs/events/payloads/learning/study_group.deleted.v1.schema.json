{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/study_group.deleted.v1.schema.json",
  "title": "Payload study_group.deleted v1 (module learning, ADR-0084)",
  "description": "Nhóm học tập bị soft-delete (ADR-0028). Consumer: module chat (lưu trữ channel study_group, giữ tin theo retention chung — không purge), AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["study_group_id", "school_id", "version", "deleted_by"],
  "properties": {
    "study_group_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "version": { "type": "integer", "minimum": 1 },
    "deleted_by": { "type": "string", "format": "uuid" }
  }
}
