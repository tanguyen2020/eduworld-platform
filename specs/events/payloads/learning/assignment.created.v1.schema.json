{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/assignment.created.v1.schema.json",
  "title": "Payload assignment.created v1 (module learning, SCHOOL_LMS §4)",
  "description": "Nhà trường (school_admin/academic_manager) tạo bài giao. Cùng payload dùng cho assignment.published (status = scheduled/open). Consumer: NTF, RT (tab Nhà trường giao trong game), LMS read model. Không chứa danh sách học sinh hay nội dung bài.",
  "type": "object",
  "additionalProperties": false,
  "required": ["assignment_id", "school_id", "created_by", "content_type", "content_id", "mode", "status", "targets", "open_at", "due_at", "feedback_timing", "result_release"],
  "properties": {
    "assignment_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "course_id": { "type": ["string", "null"], "format": "uuid" },
    "created_by": { "type": "string", "format": "uuid" },
    "created_by_role": { "type": "string", "enum": ["school_admin", "academic_manager", "system_admin"] },
    "content_type": { "type": "string", "enum": ["activity", "question_set", "assessment_blueprint", "lesson", "quest", "minigame_config"] },
    "content_id": { "type": "string", "format": "uuid" },
    "pinned_version_id": { "type": ["string", "null"], "format": "uuid", "description": "null khi follow_latest = true" },
    "follow_latest": { "type": "boolean", "default": false },
    "mode": { "type": "string", "enum": ["practice", "graded"] },
    "status": { "type": "string", "enum": ["draft", "scheduled", "open", "closed", "results_released", "archived", "cancelled"] },
    "targets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target_type"],
        "properties": {
          "target_type": { "type": "string", "enum": ["class", "study_group", "students"] },
          "target_id": { "type": ["string", "null"], "format": "uuid", "description": "class_id hoặc study_group_id; null khi target_type = students" },
          "student_count": { "type": "integer", "minimum": 0 }
        }
      }
    },
    "open_at": { "type": "string", "format": "date-time" },
    "due_at": { "type": "string", "format": "date-time" },
    "max_attempts": { "type": "integer", "minimum": 1, "maximum": 10 },
    "feedback_timing": { "$ref": "https://schemas.eduworld.vn/common/enums.schema.json#/$defs/FeedbackTiming" },
    "result_release": { "$ref": "https://schemas.eduworld.vn/common/enums.schema.json#/$defs/ResultRelease" },
    "objective_ids": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "format": "uuid" } }
  }
}
