{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/media.processed.v1.schema.json",
  "title": "Payload media.processed v1 (module learning, owner F027, ADR-0044)",
  "description": "Media worker đã quét sạch, kiểm magic bytes, xóa EXIF và ghi biến thể content-addressed media/<sha256>/<variant>.<ext>; asset ready. Envelope tenant_id = tenant sở hữu, null với media platform. Consumer: NTF (người upload).",
  "type": "object",
  "additionalProperties": false,
  "required": ["asset_id", "tenant_id", "sha256", "bucket", "variants"],
  "properties": {
    "asset_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": ["string", "null"], "format": "uuid" },
    "sha256": { "type": "string", "maxLength": 64, "pattern": "^[0-9a-f]{64}$" },
    "bucket": { "type": "string", "enum": ["ew-media-public", "ew-media-private"] },
    "variants": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["variant", "key"],
        "properties": {
          "variant": { "type": "string", "maxLength": 64 },
          "key": { "type": "string", "maxLength": 512 },
          "bytes": { "type": "integer", "minimum": 0 },
          "mime_type": { "type": "string", "maxLength": 127 }
        }
      }
    }
  },
  "examples": [
    { "asset_id": "0193a5f4-6c1e-7b2a-9d1f-000000000501", "tenant_id": null, "sha256": "9f2c4b1d8e7a6f5c4b3a29180716f5e4d3c2b1a09f8e7d6c5b4a39281706f5e4", "bucket": "ew-media-public", "variants": [ { "variant": "webp_1024", "key": "media/9f2c4b1d8e7a6f5c4b3a29180716f5e4d3c2b1a09f8e7d6c5b4a39281706f5e4/webp_1024.webp", "bytes": 81234, "mime_type": "image/webp" } ] }
  ]
}
