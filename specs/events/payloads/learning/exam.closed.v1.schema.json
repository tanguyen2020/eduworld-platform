{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/learning/exam.closed.v1.schema.json",
  "title": "Payload exam.closed v1 (module learning, owner F042)",
  "description": "Cửa sổ thi đóng (job exam-window): attempt còn mở đã tự nộp, học sinh chưa bắt đầu ghi absent (EXAM_ENGINE §7.2). Consumer: báo cáo đề (F044), thông báo.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "exam_session_id",
    "school_id",
    "exam_type",
    "is_official",
    "window_start",
    "window_end",
    "status",
    "absent_count"
  ],
  "properties": {
    "exam_session_id": {
      "type": "string",
      "format": "uuid"
    },
    "school_id": {
      "type": "string",
      "format": "uuid"
    },
    "exam_type": {
      "type": "string",
      "enum": [
        "practice_test",
        "mock",
        "chapter",
        "semester",
        "subject",
        "custom"
      ]
    },
    "is_official": {
      "type": "boolean"
    },
    "assignment_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "course_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid"
    },
    "window_start": {
      "type": "string",
      "format": "date-time"
    },
    "window_end": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "scheduled",
        "open",
        "closed",
        "results_released",
        "cancelled"
      ]
    },
    "absent_count": {
      "type": "integer",
      "minimum": 0
    },
    "auto_submitted_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "examples": [
    {
      "exam_session_id": "0193a1f0-0000-7000-8000-000000000401",
      "school_id": "0193a1f0-0000-7000-8000-000000000402",
      "exam_type": "chapter",
      "is_official": true,
      "assignment_id": null,
      "course_id": "0193a1f0-0000-7000-8000-000000000403",
      "window_start": "2026-11-21T01:00:00Z",
      "window_end": "2026-11-21T02:00:00Z",
      "status": "closed",
      "absent_count": 2,
      "auto_submitted_count": 1
    }
  ]
}
