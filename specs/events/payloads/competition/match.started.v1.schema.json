{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/match.started.v1.schema.json",
  "title": "Payload match.started v1 (module competition, owner F105)",
  "description": "Câu đầu tiên của trận hiện (countdown xong, F105-AC-26). Danh sách người tham gia và đội để module chat mở channel match/team (always-on, ADR-0020 mục 6). Không tên thật, không nickname, không điểm (R16). Consumer: chat (F117), analytics, AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["match_id", "room_id", "mode", "matchmaking_type", "ranked", "is_bot", "subject_id", "grade_level", "question_count", "started_at", "participants"],
  "properties": {
    "match_id": { "type": "string", "format": "uuid" },
    "room_id": { "type": "string", "format": "uuid" },
    "mode": { "type": "string", "enum": ["battle_1v1", "team_battle", "coop_challenge", "timed_quiz", "tournament"] },
    "matchmaking_type": { "type": "string", "enum": ["random", "skill", "grade", "subject", "topic", "friend", "team", "tournament", "bot"] },
    "ranked": { "type": "boolean" },
    "is_bot": { "type": "boolean" },
    "subject_id": { "type": "string", "format": "uuid" },
    "grade_level": { "type": "integer", "minimum": 1, "maximum": 9 },
    "question_count": { "type": "integer", "minimum": 1, "maximum": 30 },
    "question_plan_version": { "type": ["string", "null"], "maxLength": 64 },
    "tournament_node_id": { "type": ["string", "null"], "format": "uuid" },
    "started_at": { "type": "string", "format": "date-time" },
    "participants": {
      "type": "array",
      "minItems": 1,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["student_id", "tenant_id", "school_id", "team_no"],
        "properties": {
          "student_id": { "type": "string", "format": "uuid" },
          "tenant_id": { "type": "string", "format": "uuid" },
          "school_id": { "type": "string", "format": "uuid" },
          "team_no": { "type": "integer", "minimum": 0, "maximum": 1 }
        }
      }
    }
  },
  "examples": [
    {
      "match_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000c1",
      "room_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000c1",
      "mode": "battle_1v1",
      "matchmaking_type": "skill",
      "ranked": true,
      "is_bot": false,
      "subject_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000d1",
      "grade_level": 3,
      "question_count": 7,
      "question_plan_version": "qp1-6f1c2a9d0b7e4d3c",
      "tournament_node_id": null,
      "started_at": "2026-11-21T08:00:03Z",
      "participants": [
        { "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000006", "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000011", "team_no": 0 },
        { "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000007", "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000011", "team_no": 1 }
      ]
    }
  ]
}
