{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/party.member_left.v1.schema.json",
  "title": "Payload party.member_left v1 (module competition, owner F100)",
  "description": "Thành viên rời party (leaveParty, giải tán, hệ thống loại do policy — F100-AC-17, AC-20, AC-25). Consumer: chat (F117), game (F103), AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "party_id",
    "tenant_id",
    "student_id",
    "reason",
    "state_version"
  ],
  "properties": {
    "party_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "student_id": {
      "type": "string",
      "format": "uuid"
    },
    "reason": {
      "type": "string",
      "enum": [
        "left",
        "disbanded",
        "timeout",
        "policy"
      ]
    },
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "description": "multiplayer.parties.state_version sau thay đổi (tăng đúng 1 mỗi thay đổi)"
    }
  },
  "examples": [
    {
      "party_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000a1",
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000006",
      "reason": "left",
      "state_version": 2
    }
  ]
}
