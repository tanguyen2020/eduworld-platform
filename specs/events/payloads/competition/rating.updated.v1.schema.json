{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/rating.updated.v1.schema.json",
  "title": "Payload rating.updated v1 (module competition, owner F106)",
  "description": "Game Rating Glicko-2 của một học sinh sau một trận ranked, phát cùng transaction với competition.ratings + rating_changes (unique (match_id, student_id), F106-AC-02). rating/rd chỉ cho consumer server (matchmaking, seeding giải); không bao giờ đẩy tới client (realtime chỉ nhận competition.tier.updated — F106-AC-07) và không phải chỉ số học tập (ADR-0018, F106-AC-09: module learning không tiêu thụ).",
  "type": "object",
  "additionalProperties": false,
  "required": ["match_id", "student_id", "school_id", "mode", "subject_id", "season_id", "rating", "rd", "games_played", "provisional", "tier_code", "rule_version_id"],
  "properties": {
    "match_id": { "type": "string", "format": "uuid" },
    "student_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "mode": { "type": "string", "enum": ["battle_1v1", "team_battle", "timed_quiz"] },
    "subject_id": { "type": "string", "format": "uuid" },
    "season_id": { "type": "string", "format": "uuid" },
    "rating": { "type": "number" },
    "rd": { "type": "number", "minimum": 0 },
    "games_played": { "type": "integer", "minimum": 1 },
    "provisional": { "type": "boolean" },
    "tier_code": { "type": ["string", "null"], "maxLength": 64 },
    "rule_version_id": { "type": "string", "format": "uuid" }
  },
  "examples": [
    { "match_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000c1", "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000006", "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000011", "mode": "battle_1v1", "subject_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000d1", "season_id": "01936a00-0000-7000-8000-000000106001", "rating": 1662.31, "rd": 290.32, "games_played": 1, "provisional": true, "tier_code": null, "rule_version_id": "01936a00-0000-7000-8000-000000001061" }
  ]
}
