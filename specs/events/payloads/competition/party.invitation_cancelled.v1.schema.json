{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/party.invitation_cancelled.v1.schema.json",
  "title": "Payload party.invitation_cancelled v1 (module competition, owner F100)",
  "description": "Lời mời bị hủy bởi inviter/leader (cancelPartyInvitation) hoặc hệ thống (người mời bị kick, chặn nhau, sanction, rời trường — F100-AC-13, AC-18, AC-25). Consumer: NTF, AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "invitation_id",
    "party_id",
    "tenant_id",
    "inviter_id",
    "invitee_id",
    "reason"
  ],
  "properties": {
    "invitation_id": {
      "type": "string",
      "format": "uuid"
    },
    "party_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "inviter_id": {
      "type": "string",
      "format": "uuid"
    },
    "invitee_id": {
      "type": "string",
      "format": "uuid"
    },
    "cancelled_by": {
      "type": "string",
      "format": "uuid",
      "description": "Người hủy; vắng mặt = hệ thống"
    },
    "reason": {
      "type": "string",
      "enum": [
        "cancelled",
        "inviter_kicked",
        "inviter_left",
        "blocked",
        "policy"
      ]
    }
  },
  "examples": [
    {
      "invitation_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000b1",
      "party_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000a1",
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "inviter_id": "0193a5f4-6c1e-7b2a-9d1f-000000000005",
      "invitee_id": "0193a5f4-6c1e-7b2a-9d1f-000000000006",
      "cancelled_by": "0193a5f4-6c1e-7b2a-9d1f-000000000005",
      "reason": "cancelled"
    }
  ]
}
