{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/competition_points.awarded.v1.schema.json",
  "title": "Payload competition_points.awarded v1 (module competition, owner F106)",
  "description": "Competition Points ghi vào sổ cái append-only competition.competition_point_ledger cho một học sinh và một nguồn (unique (source_type, source_id, student_id), F106-AC-10), phát cùng transaction. points có thể 0 (vượt trần ngày, capped = true) hoặc âm (abandon, không đưa tổng ngày dưới 0). Thua không bị trừ. Không tên thật (R16).",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "school_id", "season_id", "source_type", "source_id", "points", "balance_after", "capped", "day_key", "rule_version_id"],
  "properties": {
    "student_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "season_id": { "type": "string", "format": "uuid" },
    "source_type": { "type": "string", "enum": ["match", "tournament"] },
    "source_id": { "type": "string", "format": "uuid" },
    "mode": { "type": ["string", "null"], "maxLength": 64 },
    "subject_id": { "type": ["string", "null"], "format": "uuid" },
    "points": { "type": "integer", "minimum": -100, "maximum": 1000 },
    "balance_after": { "type": "integer", "minimum": 0, "description": "Tổng Competition Points của học sinh trong mùa sau bút toán" },
    "capped": { "type": "boolean", "description": "true khi trần ngày (competition_points_daily_cap) đã cắt điểm của nguồn này (F106-AC-11)" },
    "day_key": { "type": "string", "format": "date", "description": "Ngày theo Asia/Ho_Chi_Minh" },
    "rule_version_id": { "type": "string", "format": "uuid" }
  },
  "examples": [
    { "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000006", "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000011", "season_id": "01936a00-0000-7000-8000-000000106001", "source_type": "match", "source_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000c1", "mode": "battle_1v1", "subject_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000d1", "points": 30, "balance_after": 30, "capped": false, "day_key": "2026-11-21", "rule_version_id": "01936a00-0000-7000-8000-000000001061" }
  ]
}
