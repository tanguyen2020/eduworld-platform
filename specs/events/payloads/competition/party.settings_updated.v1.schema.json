{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/party.settings_updated.v1.schema.json",
  "title": "Payload party.settings_updated v1 (module competition, owner F100)",
  "description": "Leader sửa cài đặt party (updatePartySettings, F100-AC-21). Chỉ tên trường đã đổi, không kèm tên party. Consumer: AUD, game (F103).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "party_id",
    "tenant_id",
    "actor_id",
    "changed_fields",
    "state_version"
  ],
  "properties": {
    "party_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "actor_id": {
      "type": "string",
      "format": "uuid"
    },
    "changed_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "name",
          "visibility",
          "invitation_policy",
          "max_members"
        ]
      }
    },
    "state_version": {
      "type": "integer",
      "minimum": 0,
      "description": "multiplayer.parties.state_version sau thay đổi (tăng đúng 1 mỗi thay đổi)"
    }
  },
  "examples": [
    {
      "party_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000a1",
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "actor_id": "0193a5f4-6c1e-7b2a-9d1f-000000000005",
      "changed_fields": [
        "visibility"
      ],
      "state_version": 3
    }
  ]
}
