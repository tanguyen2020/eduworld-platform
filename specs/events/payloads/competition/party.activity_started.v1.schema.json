{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/competition/party.activity_started.v1.schema.json",
  "title": "Payload party.activity_started v1 (module competition, owner F101)",
  "description": "Party bắt đầu phiên chơi chung (F101-AC-07): mọi thành viên tham gia vào cùng một phòng. Consumer: game (F103), chat (F117), AUD, ANA.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "party_activity_id",
    "party_id",
    "tenant_id",
    "activity_type",
    "activity_ref",
    "room_id",
    "room_type",
    "member_ids",
    "game_session_ref",
    "started_at",
    "state_version"
  ],
  "properties": {
    "party_activity_id": {
      "type": "string",
      "format": "uuid"
    },
    "party_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "format": "uuid"
    },
    "activity_type": {
      "$ref": "https://schemas.eduworld.vn/common/enums.schema.json#/$defs/PartyActivityType"
    },
    "activity_ref": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9_.-]{1,64}$",
      "description": "area_id (explore) / quest_id (quest) / boss_id (boss)"
    },
    "game_mode": {
      "type": "string",
      "maxLength": 64
    },
    "room_id": {
      "type": "string",
      "format": "uuid"
    },
    "room_type": {
      "type": "string",
      "enum": [
        "private_instance",
        "boss"
      ]
    },
    "external_ref": {
      "type": "string",
      "format": "uuid"
    },
    "member_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "format": "uuid"
      },
      "description": "Thành viên tham gia phiên (online, Ready lúc start)"
    },
    "game_session_ref": {
      "type": "string",
      "format": "uuid"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "state_version": {
      "type": "integer",
      "minimum": 0
    }
  },
  "examples": [
    {
      "party_activity_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000b1",
      "party_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000a1",
      "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "activity_type": "explore",
      "activity_ref": "forest",
      "room_id": "0193a5f4-6c1e-7b2a-9d1f-0000000000c1",
      "room_type": "private_instance",
      "member_ids": [
        "0193a5f4-6c1e-7b2a-9d1f-000000000005",
        "0193a5f4-6c1e-7b2a-9d1f-000000000006"
      ],
      "game_session_ref": "0193a5f4-6c1e-7b2a-9d1f-0000000000b1",
      "started_at": "2026-11-21T03:00:00Z",
      "state_version": 4
    }
  ]
}
