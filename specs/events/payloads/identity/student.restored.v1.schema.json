{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/identity/student.restored.v1.schema.json",
  "title": "Payload student.restored v1 (module identity, owner F016, ADR-0032)",
  "description": "Học sinh đã bị dọn được khôi phục (đăng nhập lại hoặc admin). Consumer: identity (thêm lại membership), projection ref.students (F014), LA, AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "tenant_id", "cleaned_up_at", "restored_via"],
  "properties": {
    "student_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "cleaned_up_at": { "type": "string", "format": "date-time" },
    "restored_via": { "type": "string", "enum": ["login", "admin"] }
  },
  "examples": [
    { "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000005", "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "cleaned_up_at": "2026-09-01T02:00:00Z", "restored_via": "login" }
  ]
}
