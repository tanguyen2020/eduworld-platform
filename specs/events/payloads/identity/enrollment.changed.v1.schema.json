{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/identity/enrollment.changed.v1.schema.json",
  "title": "Payload enrollment.changed v1 (module identity, owner F010)",
  "description": "Mở/đóng/chuyển enrollment của học sinh (F010-AC-13; F011 phát cùng schema khi apply SIS). Mỗi học sinh tối đa một enrollment active. Consumer: cache Principal (F003), LMS, chat (channel lớp), game (chuyển năm học), projection ref.enrollments, AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["student_id", "class_id", "op"],
  "properties": {
    "student_id": { "type": "string", "format": "uuid", "description": "= user_id của học sinh" },
    "class_id": { "type": "string", "format": "uuid" },
    "op": { "type": "string", "enum": ["added", "ended", "transferred"] },
    "enrollment_id": { "type": "string", "format": "uuid" },
    "school_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["active", "transferred", "ended"] },
    "start_date": { "type": "string", "format": "date" },
    "end_date": { "type": ["string", "null"], "format": "date" },
    "source": { "type": "string", "enum": ["sis", "manual", "platform_common"] },
    "sync_run_id": { "type": ["string", "null"], "format": "uuid" },
    "source_version": { "type": "integer", "minimum": 0, "description": "Version của aggregate nguồn (projection chỉ áp bản mới hơn — DATABASE_DESIGN §2.17); vắng mặt = dùng occurred_at của envelope" }
  },
  "examples": [
    { "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000005", "class_id": "0193a5f4-6c1e-7b2a-9d1f-000000000003", "op": "added", "enrollment_id": "0193a5f4-6c1e-7b2a-9d1f-000000000004", "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002", "status": "active", "start_date": "2026-09-05", "end_date": null, "source": "sis", "sync_run_id": null }
  ]
}
