  "examples": [
    { "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000005", "from_tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "to_tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "from_school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002", "to_school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000003" }
