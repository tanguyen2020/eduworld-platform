{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/identity/school.updated.v1.schema.json",
  "title": "Payload school.updated v1 (module identity, owner F010)",
  "description": "Trường được sửa, duyệt pending_review → active (F010-AC-09) hoặc đổi cài đặt trường (F015 phát cùng schema, kèm settings_subset). Consumer: projection ref.schools (learning, game, competition, chat), chính sách chat cấp trường, AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": ["school_id", "tenant_id", "status", "settings_subset", "changed_fields", "source_version"],
  "properties": {
    "school_id": { "type": "string", "format": "uuid" },
    "tenant_id": { "type": "string", "format": "uuid" },
    "status": { "type": "string", "enum": ["active", "pending_review", "disabled"], "description": "Trạng thái trường theo contract School.status (disabled = trường bị tắt)" },
    "name": { "type": "string", "maxLength": 255 },
    "name_i18n": { "type": "object", "additionalProperties": false, "required": ["vi"], "properties": { "vi": { "type": "string", "maxLength": 255, "minLength": 1 }, "en": { "type": "string", "maxLength": 255 } } },
    "province_code": { "type": ["string", "null"], "maxLength": 64 },
    "school_level": { "type": "string", "enum": ["primary", "lower_secondary", "multi_level"] },
    "is_virtual": { "type": "boolean" },
    "settings_subset": { "type": "object", "maxProperties": 50, "description": "Chỉ khóa cài đặt trường module nhận cần (ref.schools.settings_subset — DATABASE_DESIGN §2.17): giờ truy cập, giới nghiêm trường, giới hạn chơi/ngày, bảng xếp hạng bị tắt, allow_cross_school_listing; chính sách chat cấp trường do F122 bổ sung khóa. Không PII.", "properties": { "allowed_hours": { "type": ["object", "null"], "additionalProperties": false, "required": ["windows"], "properties": { "timezone": { "type": "string", "maxLength": 64 }, "windows": { "type": "array", "maxItems": 14, "items": { "type": "object", "additionalProperties": false, "required": ["days", "from", "to"], "properties": { "days": { "type": "array", "minItems": 1, "maxItems": 7, "uniqueItems": true, "items": { "type": "string", "enum": ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] } }, "from": { "type": "string", "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }, "to": { "type": "string", "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } } } } }, "curfew_window": { "oneOf": [{ "type": "object", "additionalProperties": false, "required": ["start", "end"], "properties": { "start": { "type": "string", "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" }, "end": { "type": "string", "maxLength": 5, "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" } } }, { "type": "null" }], "description": "Khung giới nghiêm của trường (chỉ mở rộng platform_curfew, ADR-0078); null = chỉ áp platform_curfew" }, "class_leaderboard_enabled": { "type": "boolean" }, "school_leaderboard_enabled": { "type": "boolean" }, "disabled_leaderboard_definitions": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 64 } }, "allow_cross_school_listing": { "type": "boolean" }, "student_club_creation": { "type": "boolean" }, "daily_play_limit_minutes": { "type": ["integer", "null"], "minimum": 15, "maximum": 300, "description": "Giới hạn chơi/ngày của trường (phút, F015-AC-30, OQ-17); null = tắt. Module game cưỡng chế (F014-AC-27)" } } },
    "changed_fields": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } },
    "source_version": { "type": "integer", "minimum": 0 }
  },
  "examples": [
    { "school_id": "0193a5f4-6c1e-7b2a-9d1f-000000000002", "tenant_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001", "status": "active", "name": "Trường Tiểu học Demo A", "province_code": "vn.ha-noi", "school_level": "primary", "is_virtual": false, "settings_subset": { "curfew_window": { "start": "21:00", "end": "06:30" }, "class_leaderboard_enabled": true }, "changed_fields": ["curfew_window"], "source_version": 5 }
  ]
}
