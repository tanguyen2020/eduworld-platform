{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/game/economy.adjusted.v1.schema.json",
  "title": "Payload economy.adjusted v1 (module game, owner F075)",
  "description": "Bút toán bù (Xu/vật phẩm/XP) vừa được người thứ hai duyệt và ghi sổ cái (ADR-0049, four-eyes). Consumer: AUD.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "adjustment_id",
    "student_id",
    "kind",
    "delta",
    "entry_ids",
    "reason",
    "created_by",
    "approved_by",
    "applied_at"
  ],
  "properties": {
    "adjustment_id": {
      "type": "string",
      "format": "uuid"
    },
    "student_id": {
      "type": "string",
      "format": "uuid"
    },
    "kind": {
      "type": "string",
      "maxLength": 64,
      "enum": [
        "currency",
        "item",
        "xp"
      ]
    },
    "currency_code": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64
    },
    "item_id": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+$"
    },
    "delta": {
      "type": "integer",
      "minimum": -1000000,
      "maximum": 1000000
    },
    "entry_ids": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": {
        "type": "string",
        "format": "uuid"
      }
    },
    "reason": {
      "type": "string",
      "minLength": 10,
      "maxLength": 1000
    },
    "ticket_ref": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 128
    },
    "created_by": {
      "type": "string",
      "format": "uuid"
    },
    "approved_by": {
      "type": "string",
      "format": "uuid"
    },
    "applied_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
