{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/game/content.published.v1.schema.json",
  "title": "Payload content.published v1 (module game, owner F071, ADR-0043)",
  "description": "Một item nội dung game platform được publish (lõi phát hành F071; F078 thêm workflow duyệt/rollback trên cùng lõi): con trỏ current_version_id đổi sang to_version_id. Envelope tenant_id = null (nội dung platform áp cho mọi tenant). Consumer: projection ref.minigame_config_versions của module learning (item_type = minigame_config: khối minigame_config, F073), manifest builder của module game (dựng lại game.content_manifests của mọi tenant), projection ref.world_areas của module competition (item_type = world_area: phần runtime world_area), projection ref.game_activities của learning (khối catalog, F041), AUD. Không chứa đáp án hay PII.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "item_type",
    "item_id",
    "to_version_id",
    "to_version",
    "release_id",
    "owner_scope",
    "tenant_id",
    "scheduled",
    "published_by",
    "released_at"
  ],
  "properties": {
    "item_type": {
      "type": "string",
      "enum": [
        "world_area",
        "story_chapter",
        "npc_dialogue",
        "level",
        "character_catalog",
        "item",
        "quest",
        "progression_curve",
        "reward_rule",
        "shop_item",
        "collection",
        "achievement",
        "event",
        "event_template",
        "season_track",
        "minigame_config",
        "challenge"
      ]
    },
    "item_id": {
      "type": "string",
      "maxLength": 64,
      "description": "area_id, chapter_code, dialogue_id, level_id, quest_id (F072), curve_id hoặc reward_rule_id (F074), item_id (mã vật phẩm), shop_item_id, collection_id, achievement_id (F075), event_id, template_id, season_track_id (F077), minigame_config_id (F073)"
    },
    "from_version_id": {
      "type": [
        "string",
        "null"
      ],
      "format": "uuid",
      "description": "null khi publish lần đầu"
    },
    "to_version_id": {
      "type": "string",
      "format": "uuid"
    },
    "to_version": {
      "type": "integer",
      "minimum": 1
    },
    "release_id": {
      "type": "string",
      "format": "uuid",
      "description": "Bản ghi game.content_releases"
    },
    "owner_scope": {
      "type": "string",
      "enum": [
        "platform"
      ]
    },
    "tenant_id": {
      "type": "null",
      "description": "Nội dung game là platform (ADR-0027)"
    },
    "scheduled": {
      "type": "boolean"
    },
    "published_by": {
      "type": "string",
      "format": "uuid",
      "description": "Người/nguồn publish (seed: principal hệ thống)"
    },
    "snapshot_sha256": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "released_at": {
      "type": "string",
      "format": "date-time"
    },
    "world_area": {
      "type": "object",
      "additionalProperties": false,
      "description": "Chỉ khi item_type = world_area: dữ liệu runtime room host cần (projection ref.world_areas của competition, F091)",
      "required": [
        "area_id",
        "capacity",
        "max_speed_mps",
        "bounds",
        "spawn_points",
        "allowed_grade_bands",
        "requires_unlock",
        "status"
      ],
      "properties": {
        "area_id": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)?$"
        },
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 40
        },
        "max_speed_mps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 50
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "min",
            "max"
          ],
          "properties": {
            "min": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "max": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            }
          }
        },
        "spawn_points": {
          "type": "object",
          "maxProperties": 50,
          "propertyNames": {
            "maxLength": 64
          },
          "additionalProperties": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        },
        "allowed_grade_bands": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "g1_3",
              "g4_5",
              "g6_7",
              "g8_9"
            ]
          }
        },
        "requires_unlock": {
          "type": "boolean"
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "inactive"
          ]
        }
      }
    },
    "minigame_config": {
      "type": "object",
      "additionalProperties": false,
      "description": "Chỉ khi item_type = minigame_config (F073): snapshot bất biến của version cấu hình mini-game (minigame-config.schema.json) cho projection ref.minigame_config_versions của module learning. Cấu hình không chứa câu hỏi hay đáp án (câu lấy từ Question Bank qua question_source).",
      "required": [
        "minigame_config_id",
        "version_id",
        "version",
        "minigame_type",
        "grade_levels",
        "snapshot"
      ],
      "properties": {
        "minigame_config_id": {
          "type": "string",
          "format": "uuid"
        },
        "version_id": {
          "type": "string",
          "format": "uuid"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "minigame_type": {
          "type": "string",
          "enum": [
            "multiple_choice",
            "true_false",
            "fill_in_blank",
            "drag_and_drop",
            "matching",
            "ordering",
            "calculation",
            "puzzle",
            "word_game",
            "science_simulation",
            "timed_challenge"
          ]
        },
        "grade_levels": {
          "type": "array",
          "minItems": 1,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "snapshot": {
          "type": "object",
          "maxProperties": 40,
          "description": "Payload version đã publish (minigame-config.schema.json, status = published)"
        }
      }
    },
    "config_id": {
      "type": "string",
      "format": "uuid",
      "description": "config_id của Game Operations Console (F078; bằng item_id khi item_id là UUID)"
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "description": "Metadata catalog nhà trường (F078-AC-22): chỉ khi item_type = quest hoặc minigame_config; projection ref.game_activities của module learning (F041)",
      "required": [
        "title",
        "grade_levels"
      ],
      "properties": {
        "title": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "vi"
          ],
          "properties": {
            "vi": {
              "type": "string",
              "maxLength": 255
            },
            "en": {
              "type": "string",
              "maxLength": 255
            }
          }
        },
        "grade_levels": {
          "type": "array",
          "maxItems": 9,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ],
          "format": "uuid"
        },
        "objective_ids": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string",
            "format": "uuid"
          }
        },
        "estimated_minutes": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "maximum": 600
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri",
          "maxLength": 2048
        }
      }
    },
    "content_refs": {
      "type": "array",
      "maxItems": 200,
      "description": "Nội dung học tập được tham chiếu bởi version này (OQ F054-3, FR-CNT-008): module learning dựng projection content.external_usages",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "content_type",
          "content_id"
        ],
        "properties": {
          "content_type": {
            "type": "string",
            "enum": [
              "activity",
              "question_set",
              "lesson"
            ]
          },
          "content_id": {
            "type": "string",
            "format": "uuid"
          },
          "version": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    }
  },
  "examples": [
    {
      "item_type": "world_area",
      "item_id": "main_hub",
      "from_version_id": null,
      "to_version_id": "0193a5f4-6c1e-7b2a-9d1f-000000071001",
      "to_version": 1,
      "release_id": "0193a5f4-6c1e-7b2a-9d1f-000000071002",
      "owner_scope": "platform",
      "tenant_id": null,
      "scheduled": false,
      "published_by": "0193a5f4-6c1e-7b2a-9d1f-000000071003",
      "snapshot_sha256": "abababababababababababababababababababababababababababababababab",
      "released_at": "2026-11-21T01:00:00Z",
      "world_area": {
        "area_id": "main_hub",
        "capacity": 40,
        "max_speed_mps": 7,
        "bounds": {
          "min": [
            -50,
            -5,
            -50
          ],
          "max": [
            50,
            30,
            50
          ]
        },
        "spawn_points": {
          "main_hub.default": [
            0,
            0,
            0
          ]
        },
        "allowed_grade_bands": [
          "g1_3",
          "g4_5",
          "g6_7",
          "g8_9"
        ],
        "requires_unlock": false,
        "status": "active"
      }
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "item_type": {
            "const": "minigame_config"
          }
        }
      },
      "then": {
        "required": [
          "minigame_config"
        ],
        "properties": {
          "minigame_config": true
        }
      }
    }
  ]
}
