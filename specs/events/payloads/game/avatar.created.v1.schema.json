{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.eduworld.vn/events/payloads/game/avatar.created.v1.schema.json",
  "title": "Payload avatar.created v1 (module game, owner F070)",
  "description": "Học sinh lưu avatar lần đầu (avatar_created_at đặt một lần; phát đúng một lần mỗi học sinh — F070-AC-03). Envelope tenant_id = tenant của phiên. Không họ tên, username, trường, lớp (R16, F070-AC-12). Consumer: achievement (F075), analytics.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "student_id",
    "avatar_config_hash",
    "created_at"
  ],
  "properties": {
    "student_id": {
      "type": "string",
      "format": "uuid"
    },
    "preset_code": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z0-9_]+$"
    },
    "avatar_config_hash": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[0-9a-f]{64}$",
      "description": "SHA-256 hex của avatar_config chuẩn hóa"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "examples": [
    {
      "student_id": "0193a5f4-6c1e-7b2a-9d1f-000000000001",
      "preset_code": "preset_explorer",
      "avatar_config_hash": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
      "created_at": "2026-11-20T08:00:00Z"
    }
  ]
}
